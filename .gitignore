# Dependencies
node_modules/

# Environment & secrets
.env
.env.*

# Logs
logs/
*.log

# OS
.DS_Store

# Build/runtime scratch
# (packages/*/dist is NOT tracked — each package's own .gitignore ignores it, matching
# framework-repo convention; prepare-package regenerates dist on install/pack/publish)
.temp/
.cache/
.omega/
# Per-run port-bumped emulator config (N7 auto-allocation)
firebase.resolved.json

_attic/

# Workflow state (workflow spec) — only settings.json is committed
.workkit/*
!.workkit/settings.json
