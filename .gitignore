# Dependencies
node_modules/

# Environment & secrets
.env
.env.*

# Logs
logs/
*.log

# OS
.DS_Store

# Package build output, rebuilt by prepare-package (a nested fixture dist stays tracked)
packages/*/dist/

# Build/runtime scratch
.temp/
.cache/
.omega/
# Per-run port-bumped emulator config (N7 auto-allocation)
firebase.resolved.json

# npm pack tarballs and the Firebase CLI's deploy cache
*.tgz
.firebase/
# A nested brand's deploy stages its linked frameworks here, and the snapshot has to carry them
!/brands/*/omega_modules/*.tgz

_attic/

# Workflow state (workflow spec): only settings.json is committed
.workkit/*
!.workkit/settings.json
