# Dependencies
node_modules/

# Environment & secrets
.env
.env.*

# Logs
logs/
*.log

# OS
.DS_Store

# Build/runtime scratch
# (packages/*/dist is NOT tracked — each package's own .gitignore ignores it, matching
# framework-repo convention; prepare-package regenerates dist on install/pack/publish)
.temp/
.cache/
.omega/

# Bake-off generated corpus (deterministic — regenerate via `npm run generate` in spikes/bakeoff-shared)
spikes/bakeoff-shared/corpus/

# Bake-off candidate build output
spikes/bakeoff-eleventy/_site/
spikes/bakeoff-astro/_site/
spikes/bakeoff-astro/.astro/
