{
  "description": "case-104",
  "fileLacks": ["node:test", "\\bassert\\b"],
  "tests": [
    { "name": "strictEqual", "has": [
      "ctx.expect(1).toBe(1)",
      "ctx.expect(2, 'msg-se').toBe(2)",
      "ctx.expect(3).toBe(3)",
      "ctx.expect(4, 'msg-se-multi').toBe(4)"
    ] },
    { "name": "equal", "has": [
      "ctx.expect(1).toBe(1)",
      "ctx.expect(2, 'msg-eq').toBe(2)",
      "ctx.expect(3).toBe(3)",
      "ctx.expect(4, 'msg-eq-multi').toBe(4)"
    ] },
    { "name": "deepStrictEqual", "has": [
      "ctx.expect({ a: 1 }).toEqual({ a: 1 })",
      "ctx.expect({ a: 2 }, 'msg-dse').toEqual({ a: 2 })",
      "ctx.expect({ a: 3 }).toEqual({ a: 3 })",
      "ctx.expect({ a: 4 }, 'msg-dse-multi').toEqual({ a: 4 })"
    ] },
    { "name": "deepEqual", "has": [
      "ctx.expect([1]).toEqual([1])",
      "ctx.expect([2], 'msg-de').toEqual([2])",
      "ctx.expect([3]).toEqual([3])",
      "ctx.expect([4], 'msg-de-multi').toEqual([4])"
    ] },
    { "name": "notStrictEqual", "has": [
      "ctx.expect(1).not.toBe(10)",
      "ctx.expect(2, 'msg-nse').not.toBe(20)",
      "ctx.expect(3).not.toBe(30)",
      "ctx.expect(4, 'msg-nse-multi').not.toBe(40)"
    ] },
    { "name": "notEqual", "has": [
      "ctx.expect(1).not.toBe(10)",
      "ctx.expect(2, 'msg-ne').not.toBe(20)",
      "ctx.expect(3).not.toBe(30)",
      "ctx.expect(4, 'msg-ne-multi').not.toBe(40)"
    ] },
    { "name": "notDeepStrictEqual", "has": [
      "ctx.expect({ a: 1 }).not.toEqual({ a: 10 })",
      "ctx.expect({ a: 2 }, 'msg-ndse').not.toEqual({ a: 20 })",
      "ctx.expect({ a: 3 }).not.toEqual({ a: 30 })",
      "ctx.expect({ a: 4 }, 'msg-ndse-multi').not.toEqual({ a: 40 })"
    ] },
    { "name": "notDeepEqual", "has": [
      "ctx.expect([1]).not.toEqual([10])",
      "ctx.expect([2], 'msg-nde').not.toEqual([20])",
      "ctx.expect([3]).not.toEqual([30])",
      "ctx.expect([4], 'msg-nde-multi').not.toEqual([40])"
    ] },
    { "name": "ok", "has": [
      "ctx.expect(1).toBeTruthy()",
      "ctx.expect(2, 'msg-ok').toBeTruthy()",
      "ctx.expect(3).toBeTruthy()",
      "ctx.expect(4, 'msg-ok-multi').toBeTruthy()"
    ] },
    { "name": "bare call", "has": [
      "ctx.expect(1).toBeTruthy()",
      "ctx.expect(2, 'msg-bare').toBeTruthy()",
      "ctx.expect(3).toBeTruthy()",
      "ctx.expect(4, 'msg-bare-multi').toBeTruthy()"
    ] },
    { "name": "match", "has": [
      "ctx.expect('a1').toMatch(/1/)",
      "ctx.expect('a2', 'msg-match').toMatch(/2/)",
      "ctx.expect('a3').toMatch(/3/)",
      "ctx.expect('a4', 'msg-match-multi').toMatch(/4/)"
    ] },
    { "name": "doesNotMatch", "has": [
      "ctx.expect('b1').not.toMatch(/x/)",
      "ctx.expect('b2', 'msg-dnm').not.toMatch(/x/)",
      "ctx.expect('b3').not.toMatch(/x/)",
      "ctx.expect('b4', 'msg-dnm-multi').not.toMatch(/x/)"
    ] },
    { "name": "throws", "has": [
      "ctx.expect(boom).toThrow()",
      "ctx.expect(boom, 'msg-throws').toThrow(/boom/)",
      "ctx.expect(boom, 'msg-throws-multi').toThrow(/boom/)"
    ], "count": { "ctx.expect(boom).toThrow()": 2 } },
    { "name": "doesNotThrow", "has": [
      "ctx.expect(calm).not.toThrow()"
    ], "count": { "ctx.expect(calm).not.toThrow()": 2 } },
    { "name": "rejects", "has": [
      "await ctx.expect(Promise.reject(new Error('r1'))).rejects.toThrow()",
      "await ctx.expect(Promise.reject(new Error('r2')), 'msg-rejects').rejects.toThrow(/r2/)",
      "await ctx.expect(Promise.reject(new Error('r3'))).rejects.toThrow()",
      "await ctx.expect(Promise.reject(new Error('r4')), 'msg-rejects-multi').rejects.toThrow(/r4/)"
    ], "runLacks": ["await\\s+await"] },
    { "name": "fail", "has": [
      "ctx.expect.fail('msg-fail')",
      "ctx.expect.fail('msg-fail-multi')"
    ] }
  ]
}
