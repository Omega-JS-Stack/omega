{
  "extraKnownMarketplaces": {
    "omega-local": {
      "source": {
        "source": "file",
        "path": "./.claude-plugin/marketplace.local.json"
      }
    }
  },
  "enabledPlugins": {
    "omega@omega-local": true,
    "omega@omega": false
  },
  "permissions": {
    "allow": [
      "Bash(npx omega:*)",
      "Bash(npm publish --workspace=*)",
      "Bash(cd:*)"
    ]
  }
}
