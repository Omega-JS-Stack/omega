{
  "extraKnownMarketplaces": {
    "omega": {
      "source": {
        "source": "directory",
        "path": "./"
      }
    }
  },
  "enabledPlugins": {
    "omega@omega": true
  },
  "permissions": {
    "allow": [
      "Bash(npx omega:*)",
      "Bash(npm publish --workspace=*)",
      "Bash(cd:*)"
    ]
  }
}
