// Sandbox brand — BRAND-level omega.json5 (the shared layer every target under
// targets/ inherits). Emulator-only demo project: every value here is fake/demo
// by design. Local files override any key per-surface; key presence under
// `targets` = this brand supports that target.
{
  brand: {
    id: 'sandbox-brand',
    name: 'Sandbox Brand',
    description: 'Permanent dogfood consumer for the Omega monorepo',
    url: 'https://sandbox-brand.example.com',
    contact: {
      email: 'support@sandbox-brand.example.com',
      // The human who signs the personal-signoff emails (welcome, nudge, checkup).
      // The corpus RENDERS those for real now that a testing send is captured
      // rather than delivered ([#774](https://github.com/Omega-JS-Stack/omega/issues/774)), and a missing person fails the send loudly.
      person: {
        name: 'Sandy Sandbox',
      },
    },
    address: {
      line1: '123 Main St',
      line2: 'Suite 100',
      city: 'City',
      region: 'ST',
      postalCode: '12345',
      country: 'United States',
    },
    images: {
      // Served by the web build's static channel (minted set bridged from
      // .omega/assets to /assets/images/{favicon,brand} at build)
      brandmark: 'https://sandbox-brand.example.com/assets/images/brand/brandmark.png',
      social: 'https://sandbox-brand.example.com/assets/images/brand/social.png',
    },
  },
  monitoring: {
    providers: {
      sentry: {
        dsn: 'https://d965557418748jd749d837asf00552f@o777489.ingest.sentry.io/8789941',
      },
    },
  },
  analytics: {
    providers: {
      google: {
        id: null,
      },
      meta: {
        id: null,
      },
      tiktok: {
        id: null,
      },
    },
  },
  // FAKE ASM group ids, like every other value here. A transactional send resolves
  // its unsubscribe group from config and fails loudly without one ([#649](https://github.com/Omega-JS-Stack/omega/issues/649)); the
  // corpus now renders every one of those emails into the testing-mode capture
  // ([#774](https://github.com/Omega-JS-Stack/omega/issues/774)), so this offline fixture declares its own ids instead of waiting on a
  // manage walk it will never run.
  marketing: {
    campaigns: {
      providers: {
        sendgrid: {
          groups: {
            orders: 900001,
            hello: 900002,
            account: 900003,
            marketing: 900004,
            security: 900005,
            newsletter: 900006,
            internal: 900007,
          },
        },
      },
    },
  },
  connections: {
    // A BRAND-defined provider (#771): its module is
    // targets/backend/src/connections/sandbox-pkce.js, and `name` + `logo` are
    // what the account page draws its card from — no template row anywhere.
    'sandbox-pkce': {
      enabled: true,
      name: 'Sandbox PKCE',
      logo: '/assets/images/brand/brandmark.svg',
    },
  },
  // The feature catalog (#647): every feature defined ONCE, and the products
  // below name only their value.
  features: {
    requests: {
      name: 'API Requests',
      icon: 'bolt',
      definition: 'Calls this project may make per month.',
      usage: {},
    },
  },
  payment: {
    providers: {
      stripe: {
        publishableKey: null,
      },
      paypal: {
        clientId: null,
      },
      chargebee: {
        site: null,
      },
    },
    products: [
      {
        id: 'basic',
        name: 'Basic',
        type: 'subscription',
        features: {
          requests: 10000,
        },
      },
      {
        id: 'premium',
        name: 'Premium',
        type: 'subscription',
        features: {
          requests: 100000,
        },
        trial: {
          days: 14,
        },
        prices: {
          monthly: 4.99,
          annually: 49.99,
        },
        stripe: {
          productId: null,
        },
        paypal: {
          productId: null,
        },
        chargebee: {
          itemId: null,
          legacyPlanIds: [],
        },
      },
      {
        id: 'ultimate',
        name: 'Ultimate',
        type: 'subscription',
        features: {
          requests: -1,
        },
        prices: {
          monthly: 19.99,
          annually: 199.99,
        },
        stripe: {
          productId: null,
        },
        paypal: {
          productId: null,
        },
        chargebee: {
          itemId: null,
          legacyPlanIds: [],
        },
      },
      {
        id: 'credits-100',
        name: '100 Credits',
        type: 'one-time',
        prices: {
          once: 9.99,
        },
        stripe: {
          productId: null,
        },
        chargebee: {
          itemId: null,
        },
      },
    ],
  },
  cloud: {
    provider: 'firebase',
    config: {
      apiKey: 'sandbox-api-key',
      authDomain: 'demo-sandbox-brand.firebaseapp.com',
      projectId: 'demo-sandbox-brand',
      storageBucket: 'demo-sandbox-brand.appspot.com',
      messagingSenderId: '111111111111',
      appId: '1:111111111111:web:1111111111111111111111',
      measurementId: 'G-1111111111',
    },
  },

  // Enabled targets for this brand (key presence = enabled). Type-wide
  // settings live in each target's own config/omega.json5.
  targets: {
    web: {},
    backend: {},
  },
}
