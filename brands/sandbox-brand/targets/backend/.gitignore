# ========== Default Values ==========
# macOS
.DS_Store

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*

# Firebase cache
.firebase/

# Firebase config
.firebaserc

# Staged output (generated by `omega build` — src/ is the source)
dist/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory
coverage
.nyc_output

# Dependency directories
node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variables file
.env*

# @omega.js/backend specific
.runtimeconfig.json
service-account*.json
omega-reload-trigger.js
.temp/
_legacy

# Per-run port-bumped emulator config (N7 auto-allocation)
firebase.resolved.json

# Hosting boilerplate (generated by setup / emulator boot / deploy)
/public/

# ========== Custom Values ==========
# Add your custom ignore patterns below this line
# ...
# SANDBOX BRAND: this backend is emulator-only (demo-sandbox-brand) and every
# credential-shaped file below contains FAKE demo values by design. A real
# consumer must never re-include these.
!.firebaserc
!.env
!service-account.json
