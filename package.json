{
  "name": "omega",
  "version": "0.0.0",
  "description": "OMEGA monorepo — @omegajs framework packages, shared internals, spikes, and sandbox apps",
  "private": true,
  "workspaces": [
    "packages/*",
    "spikes/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "npm run prepare:watch --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "prepare": "node -e \"require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0"
  },
  "main": "./dist/index.js",
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {}
  }
}
