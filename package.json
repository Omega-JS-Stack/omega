{
  "name": "omega",
  "version": "0.56.0",
  "description": "OMEGA monorepo — @omega.js framework packages, shared internals, and sandbox apps",
  "private": true,
  "license": "Elastic-2.0",
  "workspaces": [
    "packages/*",
    "brands/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/watch-all.js",
    "test": "node scripts/lane.js test \"npm run test:packages\" \"npm run test:corpus\" \"npm run test:e2e\" \"npm run test:e2e-extension\" \"npm run test:e2e-desktop\" \"npm run test:verts\" \"npm run test:auth\" \"npm run test:flows\" \"npm run test:journey\"",
    "test:packages": "node scripts/lane.js test:packages \"node packages/devkit/src/test/cli.js --root=scripts --log=.temp/logs/scripts.log\" \"node scripts/test-workspaces.js\"",
    "test:corpus": "node scripts/lane.js test:corpus \"node scripts/corpus-shapes.js\" \"npm run test:backend -w sandbox-brand\"",
    "test:e2e": "node packages/devkit/src/test/cli.js --root=brands/sandbox-brand/test/e2e --log=.temp/logs/test-e2e.log",
    "test:e2e-extension": "node packages/devkit/src/test/cli.js --root=test/e2e --log=.temp/logs/test-e2e-extension.log extension-auth",
    "test:e2e-desktop": "node packages/devkit/src/test/cli.js --root=test/e2e --log=.temp/logs/test-e2e-desktop.log desktop-auth",
    "test:verts": "node packages/devkit/src/test/cli.js --root=test/e2e --log=.temp/logs/test-verts.log verts-company",
    "test:auth": "node packages/devkit/src/test/cli.js --root=test/e2e --log=.temp/logs/test-auth.log auth-token",
    "test:flows": "node packages/devkit/src/test/cli.js --root=test/e2e --log=.temp/logs/test-flows.log flows",
    "test:journey": "node packages/devkit/src/test/cli.js --root=test/e2e --log=.temp/logs/test-journey.log journey",
    "test:plugin": "node packages/devkit/src/test/cli.js --root=test/e2e --log=.temp/logs/test-plugin.log plugin",
    "release:check": "node scripts/release-check.js"
  },
  "devDependencies": {
    "@omega.js/devkit": "*",
    "acorn": "^8.18.0"
  }
}
