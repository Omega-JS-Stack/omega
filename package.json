{
  "name": "omega",
  "version": "0.0.0",
  "description": "OMEGA monorepo — @omega.js framework packages, shared internals, spikes, and sandbox apps",
  "private": true,
  "workspaces": [
    "packages/*",
    "spikes/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/watch-all.js",
    "test": "node scripts/test-workspaces.js && npm run test:backend -w sandbox-brand",
    "test:packages": "node scripts/test-workspaces.js",
    "test:corpus": "npm run test:backend -w sandbox-brand",
    "test:e2e": "npm run test -w sandbox-brand"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@omega.js/devkit": "*"
  }
}
