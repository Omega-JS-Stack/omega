---
/**
 * Shared taxonomy markup (port of defaults/pages/blog-category.html and
 * blog-tag.html) — rendered by the injected category/tag routes.
 */
import { resolveLayoutModule } from '../layouts.mjs';
import { getSite } from '../render.mjs';
import { loadAssetManifest } from '../paths.mjs';
import { computeResolved } from '../resolve.mjs';
import { uj } from '../uj.mjs';

const { group, kind } = Astro.props;
const layoutModule = resolveLayoutModule('core/base');
const Layout = layoutModule.default;
const site = getSite();
const resolved = computeResolved(layoutModule.defaults, { meta: { title: group.name } });
const url = `/blog/${kind}/${group.slug}/`;
---
<Layout site={site} page={{ url }} resolved={resolved} assetManifest={loadAssetManifest()}>
  <div class="container py-5 taxonomy-page" data-taxonomy={kind}>
    <h1>{uj.ujTitleCase(group.name)}</h1>
    <p class="text-muted">{group.posts.length} posts</p>
    {group.posts.map((post) => (
      <article class="mb-3"><a href={post.url}>{post.entry.data.post.title}</a></article>
    ))}
  </div>
</Layout>
