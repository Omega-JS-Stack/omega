---
/** Injected /blog/page/[num] route — blog index pages 2..N. */
import { sortedPosts, paginate } from '../blog.mjs';
import BlogList from './blog-list.astro';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  return paginate(posts)
    .slice(1)
    .map((page) => ({ params: { num: String(page.number) }, props: { page, totalPosts: posts.length } }));
}

const { page, totalPosts } = Astro.props;
---
<BlogList page={page} totalPosts={totalPosts} />
