---
/** Injected /blog/category/[slug] route — one page per post category. */
import { sortedPosts, aggregateTaxonomy } from '../blog.mjs';
import TaxonomyPage from './taxonomy-page.astro';

export async function getStaticPaths() {
  const posts = await sortedPosts();
  return aggregateTaxonomy(posts, 'categories').map((group) => ({ params: { slug: group.slug }, props: { group } }));
}

const { group } = Astro.props;
---
<TaxonomyPage group={group} kind="category" />
