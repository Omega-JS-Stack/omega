---
/**
 * Shared blog-index markup (port of defaults/pages/blog.html) — rendered by
 * the injected /blog and /blog/page/[num] routes.
 */
import { resolveLayoutModule } from '../layouts.mjs';
import { getSite } from '../render.mjs';
import { loadAssetManifest } from '../paths.mjs';
import { computeResolved } from '../resolve.mjs';
import { uj } from '../uj.mjs';

const { page, totalPosts } = Astro.props;
const layoutModule = resolveLayoutModule('core/base');
const Layout = layoutModule.default;
const site = getSite();
const resolved = computeResolved(layoutModule.defaults, { meta: { title: 'Blog' } });
---
<Layout site={site} page={{ url: page.url }} resolved={resolved} assetManifest={loadAssetManifest()}>
  <div class="container py-5 blog-index">
    <h1>Blog <small class="text-muted">({uj.ujCommaify(totalPosts)} posts)</small></h1>
    {page.items.map((post) => (
      <article class="mb-4 blog-index-item">
        <h2 class="h4"><a href={post.url}>{post.entry.data.post.title}</a></h2>
        <p class="text-muted">{post.entry.data.post.description}</p>
      </article>
    ))}
    <nav class="d-flex gap-3 blog-pagination">
      {page.previous && <a href={page.previous}>&larr; Newer</a>}
      <span>Page {page.number} of {page.total}</span>
      {page.next && <a href={page.next}>Older &rarr;</a>}
    </nav>
  </div>
</Layout>
