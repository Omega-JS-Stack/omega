---
/**
 * /404.html — Astro's reserved 404 route, rendering the framework's default
 * 404 page content (defaults collection).
 */
import { getEntry } from 'astro:content';
import { renderPage } from '@omega/render.mjs';

const entry = await getEntry('defaults', '404');
const { Layout, site, page, resolved, contentHtml, assetManifest } = renderPage(entry, '/404.html');
---
<Layout site={site} page={page} resolved={resolved} assetManifest={assetManifest}><Fragment set:html={contentHtml} /></Layout>
