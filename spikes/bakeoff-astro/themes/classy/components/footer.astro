---
/** classy footer. */
import { ujTag } from '@omega/uj.mjs';

const { site } = Astro.props;
---
<footer class="site-footer border-top py-4 mt-5">
  <div class="container d-flex justify-content-between">
    <span>&copy; {site.brand.name} — {site.brand.description}</span>
    <span class="text-muted">{ujTag('uj_external', '"/"', { site })}</span>
  </div>
</footer>
