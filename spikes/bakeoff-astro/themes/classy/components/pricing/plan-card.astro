---
/** Plan card — the resolve-plan math as plain JS (was a Liquid filter chain). */
import { uj, ujTag } from '@omega/uj.mjs';

const { plan } = Astro.props;
const annualPerMonth = Math.round((plan.price_annually / 12) * 100) / 100;
const fullYear = plan.price_monthly * 12;
const savings = Math.round(((fullYear - plan.price_annually) / fullYear) * 100);
const star = ujTag('uj_icon', 'star', {});
---
<div class="col-md-4 mb-4">
  <div class="card plan-card h-100" data-plan={plan.id}>
    <div class="card-body text-center">
      <h3 class="card-title">{uj.ujTitleCase(plan.name)}</h3>
      <p class="plan-price display-6">${plan.price_monthly}<small>/mo</small></p>
      <p class="plan-annual text-muted">${annualPerMonth}/mo billed annually (${plan.price_annually}/yr — save {savings}%)</p>
      <ul class="list-unstyled">
        {plan.features.map((feature) => <li><Fragment set:html={star} /> {feature}</li>)}
      </ul>
      <a class="btn btn-primary" href={`/signup/?plan=${plan.id}`}>Choose {plan.name}</a>
    </div>
  </div>
</div>
