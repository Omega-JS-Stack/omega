---
/** platform-bot — gradient hero + feature cards (variable-resolved icons). */
import Base, { defaults as baseDefaults } from 'omega:layouts/core/base.astro';
import { ujTag } from '@omega/uj.mjs';

export const defaults = { ...baseDefaults };

const { resolved } = Astro.props;
const platform = resolved.platform || {};
const features = resolved.features || {};
---
<Base {...Astro.props}>
  <section class="platform-hero py-5 text-light" style={`background: ${platform.gradient}`}>
    <div class="container">
      <p class="fw-bold"><Fragment set:html={ujTag('uj_icon', JSON.stringify(platform.icon || ''), {})} /> {platform.name}</p>
      <h1 class="display-5">{resolved.hero && resolved.hero.headline}</h1>
      <p class="lead">{resolved.hero && resolved.hero.subheadline}</p>
    </div>
  </section>
  <section class="py-5">
    <div class="container">
      <h2 class="text-center mb-2">{features.heading}</h2>
      <p class="text-center text-muted mb-4">{features.subheading}</p>
      <div class="row">
        {(features.cards || []).map((card) => (
          <div class="col-md-4 mb-4 feature-card">
            <span class={`fs-3 text-${card.color}`}><Fragment set:html={ujTag('uj_icon', JSON.stringify(card.icon), {})} /></span>
            <h3 class="h5 mt-2">{card.title}</h3>
            <p>{card.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <slot />
</Base>
