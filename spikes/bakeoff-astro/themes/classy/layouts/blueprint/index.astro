---
/** blueprint/index — hero layout with frontmatter-overridable defaults. */
import Base, { defaults as baseDefaults } from 'omega:layouts/core/base.astro';
import { deepMerge } from '@omega/resolve.mjs';

export const defaults = deepMerge(baseDefaults, {
  pageModule: 'index',
  hero: { headline: 'Welcome', tagline: 'The OMEGA way', cta: 'Get started' },
});

const { resolved } = Astro.props;
---
<Base {...Astro.props}>
  <section class="hero py-5 text-center">
    <div class="container">
      <p class="hero-tagline text-accent fw-bold">{resolved.hero.tagline}</p>
      <h1 class="display-4">{resolved.hero.headline}</h1>
      <a class="btn btn-primary btn-lg mt-3" href="/signup/">{resolved.hero.cta}</a>
    </div>
  </section>
  <slot />
</Base>
