---
/** blueprint/contact. */
import Base, { defaults as baseDefaults } from 'omega:layouts/core/base.astro';
import { deepMerge } from '@omega/resolve.mjs';

export const defaults = deepMerge(baseDefaults, {});

const { resolved } = Astro.props;
---
<Base {...Astro.props}>
  <section class="contact py-5">
    <div class="container">
      <p class="hero-tagline text-accent">{resolved.hero && resolved.hero.tagline}</p>
      <h1>{(resolved.hero && resolved.hero.headline) || 'Contact us'}</h1>
      <form class="contact-form mt-4" data-form-manager="contact">
        <input type="email" name="email" class="form-control mb-3" placeholder="Email" required>
        <textarea name="message" class="form-control mb-3" placeholder="How can we help?" required></textarea>
        <button type="submit" class="btn btn-primary">Send</button>
      </form>
    </div>
  </section>
  <slot />
</Base>
