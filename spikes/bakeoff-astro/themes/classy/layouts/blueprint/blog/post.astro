---
/**
 * blueprint/blog/post — post chrome: title-cased author, filename date,
 * uj_readtime over the rendered content, slugified taxonomy links.
 */
import Base, { defaults as baseDefaults } from 'omega:layouts/core/base.astro';
import { uj, ujTag, formatPostDate, slugify } from '@omega/uj.mjs';

export const defaults = { ...baseDefaults };

const { page, resolved } = Astro.props;
const content = await Astro.slots.render('default');
const readtime = ujTag('uj_readtime', 'content', { content });
---
<Base {...Astro.props}>
  <article class="blog-post container py-5">
    <header class="mb-4">
      <h1>{resolved.post.title}</h1>
      <p class="text-muted">
        By {uj.ujTitleCase(resolved.post.author)} · {formatPostDate(page.date)} · {readtime} min read
      </p>
      <p>
        {(resolved.post.categories || []).map((category) => (
          <a class="badge text-bg-primary me-1" href={`/blog/category/${slugify(category)}/`}>{category}</a>
        ))}
      </p>
    </header>
    <div class="post-content"><Fragment set:html={content} /></div>
    <footer class="mt-4">
      {(resolved.post.tags || []).map((tag) => (
        <a class="badge text-bg-secondary me-1" href={`/blog/tag/${slugify(tag)}/`}>#{tag}</a>
      ))}
    </footer>
  </article>
</Base>
