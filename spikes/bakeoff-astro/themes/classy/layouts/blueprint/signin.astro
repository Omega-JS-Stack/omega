---
/** blueprint/signin — FormManager form + signin page module. */
import Base, { defaults as baseDefaults } from 'omega:layouts/core/base.astro';
import { deepMerge } from '@omega/resolve.mjs';

export const defaults = deepMerge(baseDefaults, {
  pageModule: 'signin',
  form: { submitLabel: 'Sign in' },
});

const { site, resolved } = Astro.props;
---
<Base {...Astro.props}>
  <section class="auth-page container py-5" data-page="signin">
    <div class="row justify-content-center">
      <div class="col-md-5">
        <h1>Sign in to {site.brand.name}</h1>
        <form class="auth-form mt-4" data-form-manager="signin">
          <input type="email" name="email" class="form-control mb-3" placeholder="Email" required>
          <input type="password" name="password" class="form-control mb-3" placeholder="Password" required>
          <button type="submit" class="btn btn-primary w-100">{resolved.form.submitLabel}</button>
        </form>
        <p class="mt-3"><a href="/signup/">Create an account</a></p>
      </div>
    </div>
  </section>
</Base>
