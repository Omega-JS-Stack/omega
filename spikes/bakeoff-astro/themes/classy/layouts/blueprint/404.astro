---
/** blueprint/404 (classy). */
import Base, { defaults as baseDefaults } from 'omega:layouts/core/base.astro';

export const defaults = { ...baseDefaults };

const { site } = Astro.props;
---
<Base {...Astro.props}>
  <section class="error-404 classy-404 py-5 text-center">
    <div class="container">
      <h1 class="display-1">404</h1>
      <p class="lead">That page doesn't exist on {site.brand.name}.</p>
      <a class="btn btn-primary" href="/">Go home</a>
    </div>
  </section>
</Base>
