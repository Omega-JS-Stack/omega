---
/**
 * core/base — the chrome layout. Head/header/footer resolve through the
 * `omega:` layer chain, so a theme overriding any of them wins with zero
 * file copying (dusk overrides head; classy fills the rest).
 */
import Head from 'omega:components/head.astro';
import Header from 'omega:components/header.astro';
import Footer from 'omega:components/footer.astro';

export const defaults = { bodyClass: 'omega-body' };

const { site, page, resolved, assetManifest } = Astro.props;
---
<html lang="en" data-theme={site.theme.id}>
<head>
<Head site={site} page={page} resolved={resolved} assetManifest={assetManifest} />
</head>
<body class={`${resolved.bodyClass} d-flex flex-column min-vh-100`}>
<Header site={site} page={page} />
<main class="flex-fill"><slot /></main>
<Footer site={site} />
</body>
</html>
