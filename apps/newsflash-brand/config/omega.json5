// The Daily Build — brand-level omega.json5 (the shared config layer every
// app under apps/ inherits; app files override per-surface; key presence
// under `targets` = target enabled). This is the SECOND-SKIN brand (Ian
// 2026-07-17): a fictional dev-news publication wearing the newsflash theme
// permanently, so classy (playground) and newsflash both stay alive. Born by
// COPY of omega-playground — offline-only: demo-* Firebase, no real cloud,
// no real external services, never production. Secrets NEVER live here —
// the loader hard-fails secret-shaped keys.
{
  // No webhook parent: offline testbed, no SendGrid account, no sub-brands.
  parent: false,
  brand: {
    id: "daily-build",
    name: "The Daily Build",
    company: "ITW Creative Works",
    description: "The dev-news daily: ship logs, release radar, and the state of the toolchain — fresh off the press.",
    tagline: "Fresh off the press.",
    color: "#F03612", // newsflash vermilion — the theme's signature accent drives the --omega-accent-* ramps
    // SUBDOMAIN of omegajs.dev (same rule as the playground): derived
    // surfaces never claim the real domain, which belongs to the future
    // standalone OMEGA brand.
    url: "https://dailybuild.omegajs.dev",
    contact: {
      // Also the test-persona domain (_test.admin@dailybuild.omegajs.dev).
      email: "support@dailybuild.omegajs.dev",
    },
    // PLACEHOLDER address (CAN-SPAM footer) — this brand never sends.
    address: {
      line1: "123 Main St",
      line2: "Suite 100",
      city: "City",
      region: "ST",
      postalCode: "12345",
      country: "United States",
    },
    images: {
      // Served by the web build's static channel: the minted set under
      // .omega/assets is bridged to /assets/images/{favicon,brand} at build.
      brandmark: "/assets/images/brand/brandmark.png",
      social: "/assets/images/brand/social.png",
    },
  },

  // Deliberately ABSENT sections (offline testbed — no real resources ever):
  // github (no repo; deploys never run here), download (no desktop/extension
  // targets — the /download page demos the notify-me flow), domain/gcp
  // (no registrar, no billing), adsense, slapform/chatsy/replyify (services
  // skip when unconfigured), certificates (no desktop target).

  // Demo project (Firebase emulators run fully offline against demo-*).
  cloud: {
    provider: "firebase",
    config: {
      apiKey: "daily-build-api-key",
      authDomain: "demo-daily-build.firebaseapp.com",
      projectId: "demo-daily-build",
      storageBucket: "demo-daily-build.appspot.com",
      messagingSenderId: "222222222222",
      appId: "1:222222222222:web:2222222222222222222222",
      measurementId: "G-2222222222",
    },
  },

  analytics: {
    providers: {
      google: { id: null },
      meta: { id: null },
      tiktok: { id: null },
    },
  },

  monitoring: {
    provider: "sentry",
    dsn: null,
  },

  // EDITORIAL catalog — placeholder products shaped like a news publication
  // so the newsflash pricing/checkout surfaces get honest test content.
  // Shapes mirror @omega.js/backend's product schema; all processor ids null
  // (offline — checkout renders, never charges).
  payment: {
    processors: {
      stripe: { publishableKey: null },
      paypal: { clientId: null },
      chargebee: { site: null },
      coinbase: { enabled: false },
    },
    products: [
      {
        id: "reader",
        name: "Reader",
        type: "subscription",
        tagline: "best for the morning skim",
        limits: { articles: 30 },
        features: [
          // definition = the dotted-underline tooltip; author it ONCE per
          // feature id — the pricing composer backfills every other copy
          { id: "articles", name: "Articles", icon: "newspaper", definition: "Full articles you can read per month." },
          { id: "ticker", name: "Live ticker", icon: "bolt", value: true, definition: "The real-time wire of releases, incidents, and ship logs." },
        ],
      },
      {
        id: "insider",
        name: "Insider",
        type: "subscription",
        tagline: "best for the daily deep read",
        popular: true,
        limits: { articles: 1000 },
        trial: { days: 14 },
        prices: { monthly: 7.99, annually: 79.99 },
        features: [
          { id: "articles", name: "Articles", icon: "newspaper" },
          { id: "ticker", name: "Live ticker", icon: "bolt", value: true },
          { id: "briefing", name: "Morning briefing", icon: "mug-hot", value: true, definition: "The editor's daily digest in your inbox before standup." },
        ],
        stripe: { productId: null },
        paypal: { productId: null },
        chargebee: { itemId: null, legacyPlanIds: [] },
      },
      {
        id: "archive-pass",
        name: "Archive Pass",
        type: "one-time",
        tagline: "every back issue, forever",
        prices: { once: 29.99 },
        features: [
          { id: "archive", name: "Full archive", icon: "box-archive", value: true, definition: "Lifetime access to every past issue and column." },
        ],
        stripe: { productId: null },
        chargebee: { itemId: null },
      },
    ],
  },

  marketing: {
    campaigns: {
      listId: null,
    },
    // A newspaper WOULD want a newsletter — but this brand is an offline
    // testbed and never sends; the beehiiv service skips deliberately.
    newsletter: {
      enabled: false,
    },
  },

  // Project-owned theme — THE POINT of this brand: the second skin.
  theme: {
    id: "newsflash",
    appearance: "system", // "system" | "light" | "dark"
  },

  // Key presence = target enabled. Web pins its dev port so The Daily Build
  // runs SIDE-BY-SIDE with the playground (classy on 4000, newsflash on
  // 4100). The backend emulator keeps the CLASSIC firebase.json ports (setup
  // enforces them); N7 auto-bumps past the playground's live set at boot and
  // publishes the resolved map (firebase.resolved.json + .temp/ports.json).
  targets: {
    web: {
      ports: {
        website: 4100,
      },
    },
    backend: {},
  },
}
