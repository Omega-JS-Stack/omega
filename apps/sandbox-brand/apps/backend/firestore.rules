// ============================================================================
// YOUR Firestore rules. This file is the SOURCE and it is yours — @omega.js/backend
// never rewrites it (it only appends a framework hook back if one goes missing).
//
// `omega build` COMPILES this file together with the framework half into
// dist/firestore.rules, and firebase.json points the emulator AND
// `firebase deploy` at that compiled artifact. Never edit the compiled file.
//
//   Framework half : node_modules/@omega.js/backend/templates/firestore.framework.rules
//   Compiled output: dist/firestore.rules  (GENERATED — do not edit)
//
// Both halves land in the SAME `match /databases/{database}/documents` scope,
// so your rules may call ANY framework helper — declaration order does not
// matter:
//
//   isAuthenticated()   authUid()            authEmail()
//   belongsTo(id)       isAdmin()            emailVerified()
//   existingData()      incomingData()
//   isCreatingField(f)  isUpdatingField(f)   isWritingField(f)
//
// See the framework half for the full list and what each one reads.
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Your rules ──────────────────────────────────────────────────────────
    // Custom rules
    // ...

    // ─── Framework hooks ─────────────────────────────────────────────────────
    // Both are REQUIRED. The compiler lints for them; a missing hook is
    // re-seeded with the default below and reported loudly.

    // Top-level `users/{uid}` keys ONLY your backend may write. Firestore ORs
    // `allow` across sibling match blocks, so a custom `match /users/{uid}`
    // can never TIGHTEN the framework's — this hook is how you do it: the
    // framework ANDs `!isWritingProtectedUserField()` into the user write rule
    // and folds this list in.
    //
    // Keys are TOP-LEVEL: protecting `xp.total` means listing `'xp'`.
    //   e.g. return ['xp', 'credits'];
    function protectedFields() {
      return [];
    }

    // Extra condition ANDed into the framework's `users/{uid}` write rule.
    // Return `true` to keep the framework default.
    //   e.g. return emailVerified();
    function canWriteUser() {
      return true;
    }
  }
}
