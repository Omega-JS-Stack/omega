// OMEGA Playground — brand-level omega.json5: the shared config layer every
// app under apps/ inherits. App files override any key per-surface; key
// presence under `targets` = this brand supports that target. Secrets NEVER
// live here — they go in the gitignored .env (the loader hard-fails on
// secret-shaped keys). This is the REHEARSAL brand (Ian 2026-07-11):
// playground identity, playground subdomain — the real OMEGA brand is born
// standalone at arc close and owns omegajs.dev.
{

  // Webhook parent topology: a brand names the parent whose central backend
  // receives account-global webhooks ('self' when this brand IS that parent
  // of sub-brands). false is CORRECT here (verified 2026-07-13): the SendGrid
  // account is SHARED with the real ITW brands and its ONE per-account event
  // webhook points at ITW's production forwarder — 'self' would hijack it.
  // The real OMEGA brand sets 'self' on its OWN SendGrid account at launch.
  parent: false,
  brand: {
    id: "omega-playground",
    name: "OMEGA Playground",
    description: "The open JavaScript stack: one brand config, every target — web, backend, desktop, and browser extension.",
    tagline: "One config. Every target.",
    color: "#3b5bdb", // PLACEHOLDER accent (drives --omega-accent-* ramp) — Ian picks with the C3 board notes
    // PLAYGROUND scope (Ian 2026-07-11): this rehearsal brand lives on a
    // SUBDOMAIN of the real domain, so every derived surface (authDomain,
    // api.playground.omegajs.dev, canonicals) stays clear of the REAL
    // omegajs.dev site — which belongs to the future standalone OMEGA brand.
    url: "https://playground.omegajs.dev",
    contact: {
      // Playground subdomain (never the real omegajs.dev): the sendgrid
      // sender derives offers@<this domain> and auto-verifies off the
      // subdomain's own domain authentication.
      email: "support@playground.omegajs.dev",
    },
    // PLACEHOLDER address (CAN-SPAM footer) — Ian's real business address at launch.
    address: {
      line1: "123 Main St",
      line2: "Suite 100",
      city: "City",
      region: "ST",
      postalCode: "12345",
      country: "United States",
    },
    images: {
      wordmark: "https://playground.omegajs.dev/wordmark.png",
      brandmark: "https://playground.omegajs.dev/brandmark.png",
      combomark: "https://playground.omegajs.dev/combomark.png",
    },
  },

  // Key presence = target enabled; the value is that target's type-wide
  // config (any shared key inside overrides it for that surface).
  targets: {
    web: {},
    backend: {},
    desktop: {},
    extension: {},
  },

  // Brand repo (github service: repo + Pages). shared: the org profile
  // belongs to the OMEGA project, not this rehearsal brand. public: GitHub
  // Pages on a free org needs a public repo — only built site output lands
  // in it (gh-pages), which is public by definition.
  github: {
    org: "Omega-JS-Stack",
    shared: true,
    private: false,
  },

  // Registrar of the PARENT omegajs.dev (subdomain project — the domain
  // service manages the parent's nameservers at Namecheap → Cloudflare).
  domain: {
    provider: "namecheap",
  },

  // REAL playground project (created 2026-07-11; console:
  // https://console.firebase.google.com/project/omegajs-playground). Values
  // are the web-app config verbatim — public by design. To run offline-only,
  // temporarily set projectId back to the demo-* convention (demo-omega-playground).
  cloud: {
    provider: "firebase",
    config: {
      apiKey: "AIzaSyDyiP9jWao8bjZML4uQr2gk0MdOEL_Umc8",
      authDomain: "playground.omegajs.dev",
      projectId: "omegajs-playground",
      storageBucket: "omegajs-playground.firebasestorage.app",
      messagingSenderId: "644778453321",
      appId: "1:644778453321:web:0d4f0f8774385a21671298",
      databaseURL: "https://omegajs-playground-default-rtdb.firebaseio.com",
      measurementId: "G-0SGDR7ZPJ9",
    },
  },

  // Manager-side provisioning intent (the manage cycle reconciles the real
  // project to this; projectId derives from cloud.config above — cp100).
  // billingAccount = ITW Main Billing Account (ID only — unusable without
  // IAM; repo is private). The billing ensure-step links it → Blaze.
  // organizationId = ITW Creative Works GCP org — projects the manager
  // creates land inside it (org placement grants the default compute SA
  // roles; legacy omega-manager hardcoded this id, now it's config).
  firebase: {
    billingAccount: "billingAccounts/01A0C2-98EAA4-A772AE",
    organizationId: "1076309192968",
  },

  analytics: {
    providers: {
      google: { id: null, accountId: "377753992", propertyId: "545069570" },
      meta: { id: null },
      tiktok: { id: null },
    },
  },

  monitoring: {
    provider: "sentry",
    dsn: null,
  },

  // PLACEHOLDER catalog (dogfood) — real OMEGA pricing is Ian's call (L10).
  // Shapes mirror @omega.js/backend's product schema.
  payment: {
    processors: {
      stripe: { publishableKey: "pk_test_51T32RbReHWMUiO2TIWCU72ATxikGDMo1a3Byl7ZiEOdDHSKsiW9v6JwRyC7BCBK8AvhTJxWpsn3dpppwdZv73lIp00oBCyjnfg" },
      paypal: { clientId: null },
      chargebee: { site: null },
      coinbase: { enabled: false },
    },
    products: [
      {
        id: "basic",
        name: "Basic",
        type: "subscription",
        tagline: "best for trying OMEGA",
        limits: { requests: 100 },
        features: [
          { id: "requests", name: "Requests", icon: "sparkles", definition: "API requests per month." },
          { id: "targets", name: "All four targets", icon: "layer-group", value: true },
        ],
      },
      {
        id: "premium",
        name: "Premium",
        type: "subscription",
        tagline: "best for shipping brands",
        popular: true,
        limits: { requests: 10000 },
        trial: { days: 14 },
        prices: { monthly: 9.99, annually: 99.99 },
        features: [
          { id: "requests", name: "Requests", icon: "sparkles" },
          { id: "targets", name: "All four targets", icon: "layer-group", value: true },
          { id: "support", name: "Priority support", icon: "headset", value: true },
        ],
        stripe: { productId: "prod_UscSf6XFplJRS1" },
        paypal: { productId: null },
        chargebee: { itemId: null, legacyPlanIds: [] },
      },
      {
        id: "launch-kit",
        name: "Launch Kit",
        type: "one-time",
        tagline: "everything to launch day one",
        prices: { once: 49.99 },
        features: [
          { id: "templates", name: "Brand templates", icon: "palette", value: 12 },
        ],
        stripe: { productId: "prod_UscSbPkRMWy3Yr" },
        chargebee: { itemId: null },
      },
    ],
  },
  marketing: {
    campaigns: {
      listId: "daae211b-bc50-4d57-ae5e-8e86f6abb734",
    },
    // No newsletter for the rehearsal brand (Ian 2026-07-12) — the beehiiv
    // service skips deliberately instead of asking for a publication.
    newsletter: {
      enabled: false,
    },
  },

  // Shared ITW AdSense account (from legacy omega-manager — one pub id
  // account-wide). The service reports Google's approval state read-only.
  adsense: {
    accountId: "pub-7372939085773564",
  },

  // ITW's REAL contact form / chat agent / email agent (ids from the legacy
  // itw-creative-works brand). Ian 2026-07-13: run them for real — "that IS
  // the point of the playground". The ensures re-brand them to this brand;
  // the next legacy itw manage run converges them back (its config still
  // owns these ids). Flip update*Info: false to make them verify-only.
  slapform: {
    formId: "UlXJ49Q4C",
  },
  chatsy: {
    agentId: "8YIsRlzAAiv03d",
  },
  replyify: {
    agentId: "stcbsieo7n1Lrk",
  },

  // AI brandmark via ITW's MrLogo instance (legacy production route — the
  // old-world /backend-manager path is MrLogo's LIVE api). Auth rides
  // LOGO_API_ID_TOKEN from .env when present; providerBrand+adminEmail are
  // the company-workspace mint path for launch-era layouts.
  assets: {
    brandmark: {
      apiUrl: "https://api.mrlogo.ai/backend-manager/logos",
      providerBrand: "mrlogo",
      adminEmail: "ian.wiedenman@gmail.com",
    },
  },

  // Project-owned theme — seeded at onboarding, yours to change.
  theme: {
    id: "classy",
    appearance: "system", // "system" | "light" | "dark"
  },

  // AI translation (web /{lang}/ copies + extension _locales) — provider
  // "claude" (default) rides the local Claude Code install; "chatgpt" needs
  // OPENAI_API_KEY in .env. Per-string cache commits to each app's translations/.
  translation: {
    languages: ["es"], // dogfood canary scope — expand at launch
  },
}
