// The bare-class allowlist for test/theme-convention.test.js (guard 1).
//
// The rule (docs/web/sections.md, "Markup convention: base, skin, fork"):
// markup classes are omega-* BEM in base, <theme>-* BEM in a theme's forks,
// or known shared vocabulary. Any OTHER bare class in theme markup fails the
// suite. A NEW bare class is a deliberate act: either prefix it per the
// convention, or add it here in review as sanctioned shared vocabulary.
//
// Shape: `patterns` are prefix entries ("btn-*" legalizes btn-lg, btn-adaptive,
// any btn-<suffix>); `literals` are exact tokens. Built from a census of the
// tree at the time guard 1 landed; every entry is pre-existing vocabulary
// (Bootstrap, Font Awesome, core JS hooks, shared base utilities).
{
  patterns: [
    // Bootstrap component and utility families
    'accordion-*',
    'alert-*',
    'align-items-*',
    'bg-*',
    'border-*',
    'bottom-*',
    'btn-*',
    'card-*',
    'col-*',
    'container-*',
    'd-*',
    'display-*',
    'dropdown-*',
    'end-*',
    'flex-*',
    'form-*',
    'fs-*',
    'fst-*',
    'fw-*',
    'g-*',
    'gap-*',
    'gx-*',
    'gy-*',
    'h-*',
    'input-group-*',
    'justify-content-*',
    'list-group-*',
    'm-*',
    'mb-*',
    'me-*',
    'modal-*',
    'ms-*',
    'mt-*',
    'mw-*',
    'mx-*',
    'my-*',
    'nav-*',
    'navbar-*',
    'object-fit-*',
    'opacity-*',
    'order-*',
    'overflow-*',
    'p-*',
    'pb-*',
    'pe-*',
    'position-*',
    'ps-*',
    'pt-*',
    'px-*',
    'py-*',
    'ratio-*',
    'rounded-*',
    'shadow-*',
    'spinner-border-*',
    'start-*',
    'table-*',
    'text-*',
    'top-*',
    'translate-*',
    'w-*',

    // Font Awesome
    'fa-*',

    // Core-hook families (base markup contracts core JS/CSS selects on)
    'animation-*',
    'app-icon-*',
    'avatar-*',
    'blog-post-*',
    'click-*',
    'cursor-*',
    'extension-*',
    'feedback-*',
    'folder-*',
    'hairline-*',
    'page-*',
    'payment-*',
    'progress-*',
    'service-*',
    'status-*',
    'step-*',
    'steps-*',
    'update-*',
    'uptime-*',
    'wizard-*',

    // Bento section token vocabulary
    'tok-*',
  ],
  literals: [
    // Bootstrap singletons
    'accordion',
    'active',
    'alert',
    'align-middle',
    'badge',
    'border',
    'btn',
    'caption-top',
    'card',
    'col',
    'collapse',
    'collapsed',
    'container',
    'disabled',
    'dropdown',
    'dropup',
    'fade',
    'font-monospace',
    'h1',
    'h2',
    'h3',
    'h4',
    'h5',
    'h6',
    'img-fluid',
    'input-group',
    'invalid-feedback',
    'lead',
    'list-group',
    'list-unstyled',
    'modal',
    'nav',
    'navbar',
    'pagination',
    'progress',
    'ratio',
    'rounded',
    'row',
    'shadow',
    'show',
    'small',
    'spinner-border',
    'stretched-link',
    'tab-content',
    'tab-pane',
    'table',
    'visually-hidden',
    'vr',

    // Font Awesome
    'fa',

    // Core JS hooks (behavior contracts that ride base markup)
    'amount',
    'billing-info',
    'button-text',
    'price-per-unit',

    // Shared base vocabulary and utilities
    'account-section',
    'app-icon',
    'avatar',
    'brandmark',
    'copy-command-btn',
    'drag-indicator',
    'file-to-click',
    'filter-adaptive',
    'hairline',
    'instruction-step-container',
    'lazy-loading',
    'mobile-email-form',
    'newsletter-form',
    'plan-action-btn',
    'platform-instructions',
    'pointer-icon',

    // Pre-existing oddity: a deliberately-parked padding class in the
    // account layout (underscore keeps it out of the css); pinned as-is.
    '_px-3',
  ],
}
