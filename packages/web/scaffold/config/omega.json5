{
  // OMEGA config — one file, one shape, every project type.
  // Docs: node_modules/@omega.js/web/README.md + docs/shared/config.md in the Omega repo.
  // Secrets NEVER live here — they go in .env (the validator hard-fails on
  // secret-shaped keys).
  brand: {
    id: 'my-brand',
    name: 'My Brand',
    url: 'https://example.com',
  },

  theme: {
    id: 'classy',
  },

  // Every key is a target NAME (it is also the folder, targets/<name>, in a
  // brand monorepo) and every entry declares the framework `type` that runs it
  targets: {
    web: { type: 'web' },
  },
}
