{
  "name": "@omega.js/web",
  "version": "0.53.0",
  "description": "The OMEGA web framework (UJM successor) — Eleventy 3 + LiquidJS + @omega.js/template-kit engine core with the `omega` CLI: layered themes with zero copying, page.resolved data cascade, frontmatter Liquid, Jekyll conventions, default pages as virtual templates, the esbuild/sass/PurgeCSS asset pipeline, and the ESM boot runtime. Private until first publish.",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "bin": {
    "omega": "bin/omega",
    "omg": "bin/omg",
    "mgr": "bin/omega"
  },
  "files": [
    "bin/",
    "core/",
    "defaults/",
    "dist/",
    "runtime/",
    "scaffold/",
    "sw/",
    "themes/",
    "translations/"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./dist/engine.js",
    "./build": "./dist/build.js",
    "./assets": "./dist/assets.js",
    "./layers": "./dist/layers.js",
    "./layouts": "./dist/layouts.js",
    "./collections": "./dist/collections.js",
    "./frontmatter-liquid": "./dist/frontmatter-liquid.js",
    "./consumer-scan": "./dist/consumer-scan.js",
    "./paths": "./dist/paths.js",
    "./consumer": "./dist/consumer.js",
    "./scaffold": "./dist/scaffold.js",
    "./deploy": "./dist/commands/deploy.js",
    "./runtime": "./runtime/omega.js",
    "./service-worker": "./sw/omega.js",
    "./migrate": "./dist/migrate/index.js",
    "./cli": "./dist/cli-run.js",
    "./ensure-target": "./dist/commands/lib/ensure-target.js"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "prepare": "node -e \"require('../devkit/tools/prepare-guard').run()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\"",
    "translate:defaults": "node src/translate/generate-defaults.js",
    "test": "node --require @omega.js/devkit/test/stdout-guard --test test/*.test.js && node --require @omega.js/devkit/test/stdout-guard --test --test-concurrency=1 test/watch/*.test.js"
  },
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "after": [
        "node -e \"require('@omega.js/devkit/prepare-guard').rewire()\"",
        "node -e \"require('@omega.js/devkit/vendor')()\""
      ],
      "afterBlocking": true
    }
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@minify-html/node": "^0.18.1",
    "@omega.js/client": "0.53.0",
    "@popperjs/core": "^2.11.8",
    "@tanstack/charts": "0.16.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "chrome-launcher": "^1.2.1",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "fs-jetpack": "^5.1.0",
    "js-yaml": "^5.4.2",
    "json5": "^2.2.3",
    "lighthouse": "^13.5.0",
    "liquidjs": "^10.29.0",
    "lodash": "^4.18.1",
    "markdown-it": "^14.3.2",
    "mermaid": "^11.17.2",
    "minimatch": "^10.2.6",
    "node-powertools": "^3.0.0",
    "purgecss": "^8.0.0",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "wonderful-fetch": "^2.0.6"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "@omega.js/template-kit": "*",
    "prepare-package": "^2.2.1"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ITW Creative Works",
  "license": "Elastic-2.0"
}
