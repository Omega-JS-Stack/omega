{
  "name": "@omega.js/web",
  "version": "0.4.0",
  "description": "The OMEGA web framework (UJM successor) — Eleventy 3 + LiquidJS + @omega.js/template-kit engine core with the `omega` CLI: layered themes with zero copying, page.resolved data cascade, frontmatter Liquid, Jekyll conventions, default pages as virtual templates, the esbuild/sass/PurgeCSS asset pipeline, and the ESM boot runtime. Private until first publish.",
  "private": true,
  "main": "./src/index.js",
  "bin": {
    "omega": "./bin/omega",
    "omg": "./bin/omg"
  },
  "exports": {
    ".": "./src/index.js",
    "./engine": "./src/engine.js",
    "./build": "./src/build.js",
    "./assets": "./src/assets.js",
    "./layers": "./src/layers.js",
    "./layouts": "./src/layouts.js",
    "./collections": "./src/collections.js",
    "./frontmatter-liquid": "./src/frontmatter-liquid.js",
    "./consumer-scan": "./src/consumer-scan.js",
    "./paths": "./src/paths.js",
    "./consumer": "./src/consumer.js",
    "./scaffold": "./src/scaffold.js",
    "./migrate": "./src/migrate/index.js",
    "./cli": "./src/cli-run.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "@omega.js/template-kit": "*",
    "@popperjs/core": "^2.11.8",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.1",
    "fs-jetpack": "^5.1.0",
    "js-yaml": "^5.2.1",
    "json5": "^2.2.3",
    "liquidjs": "^10.27.1",
    "lodash": "^4.17.21",
    "markdown-it": "^14.3.0",
    "purgecss": "^8.0.0",
    "sass": "^1.101.0",
    "wonderful-fetch": "^2.0.5",
    "yargs": "^18.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ITW Creative Works",
  "license": "MIT"
}
