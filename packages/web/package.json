{
  "name": "@omega.js/web",
  "version": "0.1.0",
  "description": "The OMEGA web framework (UJM successor) — Eleventy 3 + LiquidJS + @omega.js/template-kit engine core with the `omega` CLI: layered themes with zero copying, page.resolved data cascade, frontmatter Liquid, Jekyll conventions, default pages as virtual templates, the esbuild/sass/PurgeCSS asset pipeline, and the ESM boot runtime. Private until first publish.",
  "private": true,
  "main": "./dist/index.js",
  "bin": {
    "omega": "./bin/omega",
    "omg": "./bin/omg",
    "mgr": "./bin/omega",
    "omega-web": "./bin/omega-web"
  },
  "files": [
    "bin/",
    "core/",
    "defaults/",
    "dist/",
    "docs/",
    "runtime/",
    "scaffold/",
    "sw/",
    "themes/"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./engine": "./dist/engine.js",
    "./build": "./dist/build.js",
    "./assets": "./dist/assets.js",
    "./layers": "./dist/layers.js",
    "./layouts": "./dist/layouts.js",
    "./collections": "./dist/collections.js",
    "./frontmatter-liquid": "./dist/frontmatter-liquid.js",
    "./consumer-scan": "./dist/consumer-scan.js",
    "./paths": "./dist/paths.js",
    "./consumer": "./dist/consumer.js",
    "./scaffold": "./dist/scaffold.js",
    "./service-worker": "./sw/manager.js",
    "./migrate": "./dist/migrate/index.js",
    "./cli": "./dist/cli-run.js"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "prepare": "node -e \"require('@omega.js/devkit/prepare-guard')() && require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\"",
    "test": "node --test test/*.test.js && node --test --test-concurrency=1 test/watch/*.test.js"
  },
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "after": [
        "node -e \"require('@omega.js/devkit/vendor')()\"",
        "node -e \"require('@omega.js/devkit/prepare-guard').rewire()\""
      ],
      "afterBlocking": true
    }
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@minify-html/node": "^0.18.1",
    "@omega.js/client": "^0.1.0",
    "@popperjs/core": "^2.11.8",
    "chalk": "^5.6.2",
    "chart.js": "^4.5.1",
    "cheerio": "^1.1.0",
    "chrome-launcher": "^1.2.1",
    "dompurify": "^3.4.11",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "fs-jetpack": "^5.1.0",
    "js-yaml": "^5.2.1",
    "json5": "^2.2.3",
    "lighthouse": "^13.4.1",
    "liquidjs": "^10.27.1",
    "lodash": "^4.17.21",
    "markdown-it": "^14.3.0",
    "mermaid": "^11.16.0",
    "minimatch": "^10.2.5",
    "node-powertools": "^3.0.0",
    "purgecss": "^8.0.0",
    "sass": "^1.101.0",
    "sharp": "^0.35.3",
    "wonderful-fetch": "^2.0.5",
    "yargs": "^18.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "@omega.js/template-kit": "*",
    "prepare-package": "^2.2.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ITW Creative Works",
  "license": "Elastic-2.0"
}
