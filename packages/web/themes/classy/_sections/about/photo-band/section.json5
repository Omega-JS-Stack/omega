{
  description: 'About photo band — life in pictures: wide tiles span the grid via @bg lazy-load, stills ride responsive @srcset. Empty items suppresses the band (the layout call also honors the page\'s gallery: false kill switch).',

  args: {
    items: 'array', // [{ src, alt, caption?, wide? }]
    placeholder: 'string', // first-paint img src swapped by the lazy loader
  },

  defaults: {
    placeholder: '{{ site.omega.placeholder.src }}',
    // The framework never loads an external image at runtime: the default
    // band rides the placeholder set shipped in core/images/placeholder.
    items: [
      { src: '/assets/images/core/placeholder/photo-1.jpg', alt: 'Placeholder artwork in warm amber tones', caption: 'Shipping week, every week', wide: true },
      { src: '/assets/images/core/placeholder/photo-2.jpg', alt: 'Placeholder artwork in cool blue tones', caption: 'Pairing beats meetings' },
      { src: '/assets/images/core/placeholder/photo-3.jpg', alt: 'Placeholder artwork in soft green tones', caption: 'Plans in pencil' },
    ],
  },

  demo: [
    { label: 'Default band' },
  ],
}
