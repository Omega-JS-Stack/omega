{
  description: 'Vert unit — the fallback-ladder vert band (docs/web/ads-system.md). Its section.js arms lazily near the viewport and drives the shared client verts module: AdSense when configured (script-load failure IS the adblock detector), the in-house/company inventory as the fallback lane (sandboxed iframe, origin-validated postMessage, host-owned rotation + staleness recovery), and the built-in OMEGA promo as the terminal lane so a unit never renders empty. Hidden for paying users via the standard auth binding. Without advertising config every unit lands on the promo — key presence enables the paid lanes.',

  args: {
    type: { type: 'string', description: "Unit type: 'display' | 'in-article' | 'in-feed' | 'multiplex' (AdSense lanes) | 'house' (straight to the in-house inventory)" },
    size: { type: 'string', description: "Max-height preset — banner (150) | leaderboard (90) | rectangle (250) | large-rectangle (600) | skyscraper (600) — or a raw px value" },
    vert_id: { type: 'string', description: 'Pin a specific house vert (served only if eligible)' },
    tags: { type: 'array', description: "Contextual-targeting tags override (defaults to the brand's advertising.tags)" },
    section_class: 'string',
  },

  // Mechanical knobs only — the unit has no copy to keep neutral
  defaults: {
    type: 'display',
    size: 'rectangle',
  },

  demo: [
    {
      label: 'House unit',
      args: { type: 'house', size: 'rectangle' },
    },
  ],
}
