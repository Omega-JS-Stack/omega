{
  description: 'Interior-page masthead head cluster — optional classy-micro eyebrow, the classy-display--page h1 with optional <em> accent, optional sub line. A COMPONENT: the page keeps its own shell (dotgrid section, container, duo/split wrappers) and composes this inside it; breadcrumb-eyebrow pages (blog taxonomy, alternative) pass no eyebrow and keep their link row in the layout. SHARED across the interior pages — defaults stay NEUTRAL (spec §6); sub_class/h1_class are mechanical knobs.',

  args: {
    eyebrow: 'string',
    headline: 'string',
    headline_accent: 'string',
    sub: 'string',
    sub_class: 'string',
    h1_class: 'string',
  },

  defaults: {
    sub_class: 'classy-hero-split__sub',
  },
}
