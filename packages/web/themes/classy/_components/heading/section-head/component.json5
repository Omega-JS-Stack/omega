{
  description: 'Section-head cluster — optional classy-micro eyebrow, the classy-display--section h2 with optional <em> accent (whole h2 suppressed when headline is blank), optional plain sub line. A COMPONENT: the caller owns the classy-section-head wrapper div and everything after the cluster. Composed by layouts AND by sections (nested composition — pass the resolved string as superheadline, e.g. args.superheadline.text). Fully neutral: no defaults.',

  args: {
    superheadline: 'string',
    headline: 'string',
    headline_accent: 'string',
    sub: 'string',
  },

  defaults: {},
}
