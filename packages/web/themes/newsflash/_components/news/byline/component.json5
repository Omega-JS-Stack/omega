{
  description: 'Newsflash byline — author name (omega_member lookup from the author id) · pre-formatted date · readtime in minutes. Callers pre-capture readtime (omega_readtime needs post content, which never rides args). p_class carries the variant.',

  args: {
    author: 'string',
    date: 'string',
    readtime: 'string',
    p_class: 'string',
  },

  defaults: {
    p_class: 'small text-body-secondary mb-0',
  },

  // No demo (spec §9, deliberate): the component resolves its author through
  // omega_member against live site content — a showcase page can't fabricate
  // that lookup, so the entry documents args only.
}
