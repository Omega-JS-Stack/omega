{
  description: "The dark big-read band — cta-panel + spinning rings, italic serif title with the vermilion accent, warning-yellow primary button. Theme-layer override of classy's marketing/cta serving the same contract; icons render when the data carries them (classy ignores icon keys), and command renders as the mono $ button in panel idiom. A SHARED band — defaults stay NEUTRAL and every caller passes its own copy (spec §6 shared-band ruling).",

  args: {
    superheadline: 'object',
    headline: 'string',
    headline_accent: 'string',
    subheadline: 'string',
    primary_button: 'object',
    secondary_button: 'object',
    command: 'string',
    command_href: 'string',
    section_class: 'string',
  },

  defaults: {},

  // Showcase variants (spec §9) — same generic copy shape as the classy
  // base's demo; here the icon keys actually render (the override's
  // distinguishing feature).
  demo: [
    {
      label: 'Full band',
      args: {
        superheadline: { icon: 'bolt', text: 'Get started' },
        headline: 'Ready to ship',
        headline_accent: 'something great?',
        subheadline: 'Start free and grow into every surface your product needs.',
        primary_button: { text: 'Start free', href: '/signup', icon: 'rocket' },
        command: 'npx acme setup',
        secondary_button: { text: 'Talk to sales', href: '/contact', icon: 'headset' },
      },
    },
    {
      label: 'Minimal',
      args: {
        headline: 'Try it today',
        primary_button: { text: 'Get started', href: '/signup' },
      },
    },
  ],
}
