{
  description: 'The rundown — the newsroom playbook: rule head, lede header, then a numbered feed of items. Newsflash-specific; the index passes its copy over the data bridge (superheadline.icon rides the data but the head renders text only).',

  args: {
    superheadline: 'object',
    headline: 'string',
    headline_accent: 'string',
    subheadline: 'string',
    items: 'array',
  },

  defaults: {},

  // Showcase variants (spec §9)
  demo: [
    {
      label: 'Three-step playbook',
      args: {
        superheadline: { text: 'The rundown' },
        headline: 'How the newsroom',
        headline_accent: 'ships',
        subheadline: 'The playbook, in the order it actually happens.',
        items: [
          {
            title: 'Report it',
            description: 'Every story starts at a desk, with a byline on the hook.',
          },
          {
            title: 'Edit it',
            description: 'Two reads minimum — copy first, then the desk editor.',
          },
          {
            title: 'Publish it',
            description: 'One verb ships it to every edition at once.',
          },
        ],
      },
    },
  ],
}
