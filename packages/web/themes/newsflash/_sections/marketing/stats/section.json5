{
  description: 'Newsflash override of the stats band — masthead numbers with stroked numerals under a rule head. Same items contract as the classy base (number/label/sublabel); absent items suppresses the band. head is the rule-head label — a theme default, part of the newsflash identity.',

  args: {
    items: 'array',
    head: 'string',
    after: 'html', // same contract as the classy base: finished markup after the grid, inside the container
  },

  defaults: {
    head: 'By the numbers',
  },

  // Showcase variants (spec §9) — items ride the demo (the base contract);
  // the head default is the theme's own.
  demo: [
    {
      label: 'Masthead numbers',
      args: {
        items: [
          { number: '2M+', label: 'Monthly readers', sublabel: 'And climbing' },
          { number: '48', label: 'States covered', sublabel: 'Plus the territories' },
          { number: '6am', label: 'Daily deadline', sublabel: 'Never missed' },
          { number: '12', label: 'Desks', sublabel: 'One newsroom' },
        ],
      },
    },
  ],
}
