{
  description: 'The ink CTA band — on by default, enabled: false removes it entirely; optional superheadline micro label, headline with optional <em> accent, optional subheadline, then primary button / mono command / secondary button (each renders only when set; secondary_button.nudge: true adds the arrow). A SHARED band (index, about, pricing, download, extension, team, alternatives) — defaults stay NEUTRAL and every page passes its own copy over the data bridge (spec §6 shared-band ruling).',

  args: {
    enabled: 'boolean',
    superheadline: 'object',
    headline: 'string',
    headline_accent: 'string',
    subheadline: 'string',
    primary_button: 'object',
    secondary_button: 'object',
    command: 'string',
    command_href: 'string',
    section_class: 'string',
  },

  defaults: {
    // Mechanical knob only (§6): the family gate. ON by default — a page that
    // wants no CTA at all passes enabled: false and the band disappears
    // instead of shipping framework words or an empty panel.
    enabled: true,
  },

  // Showcase variants (spec §9) — a SHARED band keeps neutral defaults, so
  // the demo carries its own generic copy.
  demo: [
    {
      label: 'Full band',
      args: {
        superheadline: { text: 'Get started' },
        headline: 'Ready to ship',
        headline_accent: 'something great?',
        subheadline: 'Start free and grow into every surface your product needs.',
        primary_button: { text: 'Start free', href: '/signup', icon: 'rocket' },
        command: 'npx acme setup',
        secondary_button: { text: 'Talk to sales', href: '/contact', nudge: true },
      },
    },
    {
      label: 'Minimal',
      args: {
        headline: 'Try it today',
        primary_button: { text: 'Get started', href: '/signup' },
      },
    },
  ],
}
