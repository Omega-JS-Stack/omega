{
  description: 'Logo marquee — the "trusted by" wall. Per logo: `logo` = combomark slug (core/logos, the REAL wordmark lockups); `icon` = the full Font Awesome class string (mark + name lockup), e.g. `fa-brands fa-github`; `src` = custom image; name-only falls back to the typographic word. Empty logos suppresses the band.',

  args: {
    headline: 'string',
    logos: 'array',
  },

  defaults: {
    headline: 'Trusted by teams at',
    logos: [
      { name: 'Amazon', logo: 'amazon' },
      { name: 'Google', logo: 'google' },
      { name: 'HubSpot', logo: 'hubspot' },
      { name: 'PayPal', logo: 'paypal' },
      { name: 'Slack', logo: 'slack' },
      { name: 'Shopify', logo: 'shopify' },
      { name: 'Stripe', logo: 'stripe' },
      { name: 'GitHub', logo: 'github' },
    ],
  },

  // Showcase variants (spec §9)
  demo: [
    { label: 'Default wall' },
    {
      label: 'Three logos, one per mode',
      args: {
        headline: 'Backed by',
        logos: [
          { name: 'Google', logo: 'google' },
          { name: 'GitHub', icon: 'fa-brands fa-github' },
          { name: 'Initech' },
        ],
      },
    },
  ],
}
