{
  description: 'FAQ accordion band — aside head + Bootstrap accordion in the asymmetric duo layout by default; variant: "center" stacks a centered head over a narrowed accordion (col-lg-8). A SHARED band (contact, download, extension, alternatives) — defaults stay NEUTRAL and every page passes its own copy over the data bridge (spec §6 shared-band ruling). Pricing keeps its own inline copy: its aside embeds the bespoke billing-guarantee object.',

  args: {
    superheadline: 'object', // { text } — the micro label is words only
    headline: 'string',
    headline_accent: 'string',
    subheadline: 'string',
    items: 'array',
    variant: 'string',
    dom_id: 'string',
  },

  defaults: {
    // Mechanical knob only (§6): Bootstrap collapse wires by DOM id; a second
    // instance on one page passes its own namespace.
    dom_id: 'faq',
  },

  // Showcase variants (spec §9) — a SHARED band keeps neutral defaults, so
  // the demo carries its own generic copy. Both variants render on one page,
  // so each passes its own dom_id (exactly what the knob is for).
  demo: [
    {
      label: 'Duo layout',
      args: {
        superheadline: { text: 'FAQ' },
        headline: 'Common questions',
        subheadline: 'Short answers to the things people ask first.',
        dom_id: 'demoFaqDuo',
        items: [
          {
            question: 'Do I need a credit card to start?',
            answer: 'No. The free plan needs only an email address.',
          },
          {
            question: 'Can I bring my own domain?',
            answer: 'Yes. Point your DNS at us and certificates are handled automatically.',
          },
          {
            question: 'What happens if I cancel?',
            answer: 'Your site keeps running until the end of the billing period, and your content exports any time.',
          },
        ],
      },
    },
    {
      label: 'Centered',
      args: {
        variant: 'center',
        superheadline: { text: 'FAQ' },
        headline: 'Questions,',
        headline_accent: 'answered',
        dom_id: 'demoFaqCenter',
        items: [
          {
            question: 'Is there a free tier?',
            answer: 'Yes. Free forever for personal projects.',
          },
          {
            question: 'How do upgrades work?',
            answer: 'One click from the dashboard; changes prorate automatically.',
          },
        ],
      },
    },
  ],
}
