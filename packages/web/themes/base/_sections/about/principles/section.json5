{
  description: 'About principles — the numbered values list under a centered section head. Order is the statement: item 1 outranks item 2. The layout bridges the page\'s values object via data:.',

  args: {
    superheadline: 'object', // { text }
    headline: 'string',
    headline_accent: 'string',
    subheadline: 'string',
    items: 'array', // [{ title, description }] — icons intentionally unrendered; the index number is the mark
  },

  defaults: {
    superheadline: { text: 'Principles' },
    headline: 'What we <em>refuse</em> to compromise on',
    // An ABSENT subheadline renders NOTHING (#512): the optional sub line is
    // never a demo sentence a brand's own band inherits. The demo copy lives
    // in the variant below.
    subheadline: '',
    items: [
      { title: 'Ship it simple', description: 'The smallest thing that solves the problem wins.' },
      { title: 'Own the outcome', description: 'Everyone ships; everyone answers for what ships.' },
      { title: 'Say it plainly', description: 'Clear words over clever ones, in product and in person.' },
    ],
  },

  demo: [
    {
      label: 'Default principles',
      args: {
        subheadline: 'Our working principles, in order.',
      },
    },
  ],
}
