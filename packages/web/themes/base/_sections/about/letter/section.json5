{
  description: 'About letter — mission & vision as editorial statements beside the living ops-feed aside (theme flavor markup). Supply image: and a photo sits at the top of the aside, so the statements read beside a picture instead of a wall. The layout bridges mission:/vision: objects from the page.',

  args: {
    aside_label: 'string',
    feed_label: 'string',
    mission: 'object', // { title, description }
    vision: 'object', // { title, description }
    image: 'string', // aside photo; unset = no frame, the aside as it was
    image_alt: 'string', // what the photo SHOWS — content imagery, never decoration
    placeholder: 'string', // first-paint img src swapped by the lazy loader
  },

  defaults: {
    aside_label: 'Why we exist',
    feed_label: 'This week at {{ site.brand.name }}',
    mission: {
      title: 'Our mission',
      description: 'To empower individuals and businesses with technology that <em>simplifies</em> complex challenges and unlocks new possibilities for growth.',
    },
    vision: {
      title: 'Our vision',
      description: 'A world where powerful tools feel effortless, where anyone can build, launch, and grow without wrestling the machinery. That\'s the product we <em>refuse to stop</em> working toward.',
    },
    image: '',
    image_alt: '',
    placeholder: '{{ site.omega.placeholder.src }}',
  },

  demo: [
    { label: 'Default letter' },
    {
      label: 'With the aside photo',
      args: {
        image: '/assets/images/core/placeholder/photo-3.jpg',
        image_alt: 'Placeholder artwork in soft green tones',
      },
    },
  ],
}
