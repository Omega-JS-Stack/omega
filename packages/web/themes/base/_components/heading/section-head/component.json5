{
  description: 'Section-head cluster — optional omega-micro eyebrow, the omega-display--section h2 with optional <em> accent (whole h2 suppressed when headline is blank), optional plain sub line. A COMPONENT: the caller owns the omega-section-head wrapper div and everything after the cluster. Composed by layouts AND by sections (nested composition — pass the resolved string as superheadline, e.g. args.superheadline.text). Fully neutral: no defaults.',

  args: {
    superheadline: 'string',
    headline: 'string',
    headline_accent: 'string',
    sub: 'string',
  },

  defaults: {},

  // Showcase variants (spec §9) — stage_class supplies the wrapper the
  // caller normally owns, so the demo renders in its natural shell.
  demo: [
    {
      label: 'Full cluster',
      stage_class: 'omega-section-head',
      args: {
        superheadline: 'Features',
        headline: 'Built for',
        headline_accent: 'momentum',
        sub: 'A supporting line under the section head.',
      },
    },
  ],
}
