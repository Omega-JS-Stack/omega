{
  description: 'Interior-page masthead head cluster — optional omega-micro eyebrow, the omega-display--page h1 with optional <em> accent, optional sub line. A COMPONENT: the page keeps its own shell (dotgrid section, container, duo/split wrappers) and composes this inside it; breadcrumb-eyebrow pages (blog taxonomy, alternative) pass no eyebrow and keep their link row in the layout. SHARED across the interior pages — defaults stay NEUTRAL (spec §6); sub_class/h1_class are mechanical knobs.',

  args: {
    eyebrow: 'string',
    headline: 'string',
    headline_accent: 'string',
    sub: 'string',
    sub_class: 'string',
    h1_class: 'string',
    first_paint: 'boolean', // #467: this cluster IS the first viewport — drop the reveal attributes, the band's data-omega-first-paint owns the paint
  },

  defaults: {
    sub_class: 'omega-hero-split__sub',
  },

  // Showcase variants (spec §9)
  demo: [
    {
      label: 'Eyebrow + accent + sub',
      args: {
        eyebrow: 'Guides',
        headline: 'Everything about',
        headline_accent: 'getting started',
        sub: 'A short standfirst under the display headline.',
      },
    },
  ],
}
