{
  // Default user-app nav: no Dashboard entry ships because no default
  // homepage does (/dashboard forwards to account) — a brand that scaffolds
  // its own /dashboard overrides this json and adds its nav alongside.
  logo: {
    href: '/dashboard/account',
    class: 'filter-adaptive',
  },
  links: [
    {
      header: true,
      label: 'General'
    },
    {
      label: 'Account',
      href: '/dashboard/account',
      icon: 'fa-solid fa-user-gear'
    },
    {
      label: 'Pricing',
      href: '/pricing',
      icon: 'fa-solid fa-credit-card'
    },
    {
      label: 'Contact support',
      href: '/contact',
      icon: 'fa-solid fa-circle-question'
    },
  ],

  // The rail vert slot — the user app opts in; a brand with no `advertising`
  // config renders nothing (the include's second gate), and paying users never
  // see the unit (the standard auth binding).
  bottom: {
    vert: {
      enabled: true,
    },
  },
}
