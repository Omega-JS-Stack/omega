# ========== Default Values ==========
# Commented keys are PLACEHOLDERS: values resolve through the .env cascade
# (shell > this file > brand root .env > company .env) — uncomment here only
# to override for THIS app. An empty value never claims a key.
# Github Token
# Get token at: https://github.com/settings/tokens
# GH_TOKEN=

# Google Analytics 4 Measurement Protocol API secret
# Pairs with analytics.providers.google.id in config/omega.json5 (secrets never live there).
# Baked into the build snapshot (build.json / OMEGA_BUILD_JSON) at build time.
# GOOGLE_ANALYTICS_SECRET=

# Chrome Web Store Publishing Credentials
# Get credentials at: https://developer.chrome.com/docs/webstore/using_webstore_api/
# CHROME_EXTENSION_ID=
# CHROME_CLIENT_ID=
# CHROME_CLIENT_SECRET=
# CHROME_REFRESH_TOKEN=

# Firefox Add-ons Publishing Credentials
# Get credentials at: https://addons.mozilla.org/developers/addon/api/key/
# FIREFOX_EXTENSION_ID=
# FIREFOX_API_KEY=
# FIREFOX_API_SECRET=

# Microsoft Edge Add-ons Publishing Credentials
# Get credentials at: https://learn.microsoft.com/en-us/microsoft-edge/extensions-chromium/publish/api/using-addons-api
# EDGE_PRODUCT_ID=
# EDGE_CLIENT_ID=
# EDGE_API_KEY=

# Opera Add-ons
# NOTE: Opera does not have a publishing API. Extensions must be submitted manually at:
# https://addons.opera.com/developer/

# OpenAI API key — ONLY needed when translation.provider is "chatgpt"
# (the default "claude" provider rides the local Claude Code install, no key)
# OPENAI_API_KEY=

# ========== Custom Values ==========
# ...
