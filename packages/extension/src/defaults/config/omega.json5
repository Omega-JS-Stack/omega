// config/omega.json5 — the single OMEGA config file (JSON5: comments + trailing commas OK).
//
// Shape: SHARED sections at the top level (identical spelling in every OMEGA project
// type: web, backend, extension, desktop), then a `targets` object whose every KEY
// is a target NAME (the folder targets/<name> in a brand monorepo) and whose every
// entry declares its framework `type` plus that target's own settings. Any shared key may also appear inside a target entry to override it for
// that surface only (e.g. an extension-specific monitoring.providers.sentry.dsn
// under targets.extension).
//
// Secrets NEVER live here — they live in .env. The validator hard-fails on
// secret-shaped keys (…Secret, …privateKey).
{
  brand: {
    id: 'my-brand',
    name: 'My Brand',
    url: 'https://example.com',
    contact: {
      email: 'support@example.com',
    },
  },

  monitoring: {
    providers: {
      sentry: {
        dsn: '',
      },
    },
  },

  // GA4 analytics. Measurement ID lives in config (not secret); the API secret
  // lives in `process.env.GOOGLE_ANALYTICS_SECRET` (.env — matches @omega.js/backend/EM convention)
  // and is baked into the build snapshot (OMEGA_BUILD_JSON, the artifact's build.js) at build time.
  analytics: {
    providers: {
      google: {
        id: '',
      },
    },
  },

  // Firebase web-app config (public client keys — real secrets stay in .env).
  // Fill from Firebase console → Project settings → your web app.
  cloud: {
    provider: 'firebase',
    config: {
      apiKey: '',
      authDomain: '',
      projectId: '',
      storageBucket: '',
      messagingSenderId: '',
      appId: '',
    },
  },

  theme: {
    id: 'classy',
  },

  // KEY PRESENCE = enabled. `extension: {}` = enabled with defaults (the extension
  // target section is near-empty by design — extension-specific settings land here).
  targets: {
    extension: {
      type: 'extension',
      // What this extension SHIPS (#867), in the SAME shape the desktop target
      // declares: presence = enabled, every browser and format below is ON by
      // default, and the only way to drop one is `false` (e.g. `edge: false`,
      // or `store: false` to build the zip without publishing).
      //
      // `zip` is attached to the brand's releases repo; `store` is published to
      // that browser's store, which needs its API credentials (the manage walk
      // asks for them) plus, for chrome and edge, the listing id in
      // `listings.<browser>.id`. `edge` ships the CHROME build: two stores, one
      // chromium artifact.
      platforms: {
        chrome:  { formats: { zip: {}, store: {} } },
        firefox: { formats: { zip: {}, store: {} } },
        edge:    { formats: { zip: {}, store: {} } },
      },
    },
  },
}
