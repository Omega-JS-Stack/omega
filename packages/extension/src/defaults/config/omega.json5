// config/omega.json5 — the single OMEGA config file (JSON5: comments + trailing commas OK).
//
// Shape: SHARED sections at the top level (identical spelling in every OMEGA project
// type — website, backend, extension, desktop), then a `targets` object whose KEY
// PRESENCE says which targets this brand enables and whose values hold target-scoped
// settings. Any shared key may also appear inside a target entry to override it for
// that surface only (e.g. an extension-specific monitoring.dsn under targets.extension).
//
// Secrets NEVER live here — they live in .env. The validator hard-fails on
// secret-shaped keys (…Secret, …privateKey).
{
  brand: {
    id: 'my-brand',
    name: 'My Brand',
    url: 'https://example.com',
    contact: {
      email: 'support@example.com',
    },
  },

  monitoring: {
    provider: 'sentry',
    dsn: '',
  },

  // GA4 analytics. Measurement ID lives in config (not secret); the API secret
  // lives in `process.env.GOOGLE_ANALYTICS_SECRET` (.env — matches @omega.js/backend/EM convention)
  // and is baked into the build snapshot (build.json / OMEGA_BUILD_JSON) at build time.
  analytics: {
    providers: {
      google: {
        id: '',
      },
    },
  },

  // Firebase web-app config (public client keys — real secrets stay in .env).
  // Fill from Firebase console → Project settings → your web app.
  cloud: {
    provider: 'firebase',
    config: {
      apiKey: '',
      authDomain: '',
      projectId: '',
      storageBucket: '',
      messagingSenderId: '',
      appId: '',
    },
  },

  theme: {
    id: 'classy',
  },

  // KEY PRESENCE = enabled. `extension: {}` = enabled with defaults (the extension
  // target section is near-empty by design — extension-specific settings land here).
  targets: {
    extension: {},
  },
}
