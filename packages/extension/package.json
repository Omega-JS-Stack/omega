{
  "name": "@omega.js/extension",
  "version": "2.1.0",
  "description": "OMEGA extension framework — build, test, and package Chrome/Firefox extensions (MV3)",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/vendor/config/index.js",
    "./build": "./dist/build.js",
    "./background": "./dist/background.js",
    "./content": "./dist/content.js",
    "./popup": "./dist/popup.js",
    "./sidepanel": "./dist/sidepanel.js",
    "./options": "./dist/options.js",
    "./page": "./dist/page.js",
    "./offscreen": "./dist/offscreen.js",
    "./lib/affiliatizer": "./dist/lib/affiliatizer.js",
    "./lib/extension": "./dist/lib/extension.js",
    "./lib/logger-lite": "./dist/lib/logger-lite.js",
    "./lib/messaging": "./dist/lib/messaging.js",
    "./cli": "./dist/cli-run.js"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "prepare": "node -e \"require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\"",
    "test": "node ./bin/omega-extension test"
  },
  "bin": {
    "omega": "./bin/omega",
    "omg": "./bin/omg",
    "mgr": "./bin/omega",
    "omega-extension": "./bin/omega-extension"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "CLAUDE.md"
  ],
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "after": "node -e \"require('@omega.js/devkit/vendor')()\""
    }
  },
  "projectScripts": {
    "start": "npx omega clean && npx omega setup && npm run gulp --",
    "gulp": "gulp --cwd ./ --gulpfile ./node_modules/@omega.js/extension/dist/gulp/main.js",
    "build": "npx omega clean && npx omega setup && BXM_BUILD_MODE=true npm run gulp -- build",
    "publish": "BXM_IS_PUBLISH=true npm run gulp -- publish",
    "release": "npm run build && npm run publish",
    "test": "npx omega test"
  },
  "engines": {
    "node": "22"
  },
  "keywords": [
    "omega",
    "browser-extension",
    "chrome-extension",
    "firefox-extension",
    "edge-extension",
    "web-extension",
    "manifest-v3",
    "gulp",
    "sass",
    "webpack"
  ],
  "author": "ITW Creative Works",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.138",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@popperjs/core": "^2.11.8",
    "babel-loader": "^10.1.1",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "fs-jetpack": "^5.1.0",
    "glob": "^13.0.6",
    "gulp-clean-css": "^4.3.0",
    "gulp-filter": "^10.0.0",
    "gulp-rename": "^2.1.0",
    "gulp-responsive-modern": "^1.0.0",
    "gulp-sass": "^6.0.1",
    "itwcw-package-analytics": "^1.0.8",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "node-powertools": "^3.0.0",
    "npm-api": "^1.0.1",
    "sass": "^1.100.0",
    "@omega.js/client": "^5.0.0",
    "webpack": "^5.107.2",
    "wonderful-fetch": "^2.0.5",
    "wonderful-version": "^1.3.2",
    "ws": "^8.21.0",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "gulp": "^5.0.1"
  },
  "devDependencies": {
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "prepare-package": "^2.1.0",
    "puppeteer": "^24.43.1"
  }
}
