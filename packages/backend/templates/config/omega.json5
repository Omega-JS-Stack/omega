// omega.json5 — the ONE config file for every OMEGA project type.
//
// Shared sections (brand, cloud, analytics, payment, monitoring, oauth2)
// sit at the top level with identical spelling in every omega.json5. Backend
// settings live under targets.backend — key presence under `targets` means
// "this project supports this target".
//
// This file doubles as @omega.js/backend's framework-defaults layer: the Manager
// resolves it through @omega.js/config and merges the consumer's own
// functions/config/omega.json5 on top. Secrets NEVER live here — they go in
// functions/.env (the loader hard-fails on secret-shaped keys).
{
  brand: {
    id: 'my-app',
    name: 'My Brand',
    description: '',
    url: 'https://example.com',
    contact: {
      email: 'support@example.com',
      // Email identity — deliberately UNSET here so this defaults layer never supplies
      // an identity a brand did not choose. Set them in your own config when needed:
      //   person:     { name: 'Jane Doe, CEO', firstName: 'Jane', image, url, urlText }
      //               required to send email with a "personal" signoff (the send throws without it)
      //   carbonCopy: [{ email: 'audit@example.com', name: 'Audit' }]
      //               audit BCCs added to transactional sends with copy: true
    },
    // Physical postal address — required by CAN-SPAM in commercial email footers.
    // Rendered in the newsletter footer + transactional email footers.
    // Structured so the renderer can format it consistently across locales
    // and break onto multiple lines if needed. line2/region/postalCode are optional.
    address: {
      line1: '123 Main St',
      line2: 'Suite 100',
      city: 'City',
      region: 'ST',
      postalCode: '12345',
      country: 'United States',
    },
    images: {
      wordmark: 'https://example.com/wordmark.png',
      brandmark: 'https://example.com/wordmark.png',
      combomark: 'https://example.com/combomark.png',
    },
  },
  monitoring: {
    providers: {
      sentry: {
        dsn: 'https://d965557418748jd749d837asf00552f@o777489.ingest.sentry.io/8789941',
      },
    },
  },
  analytics: {
    providers: {
      google: {
        id: null,
      },
      meta: {
        id: null,
      },
      tiktok: {
        id: null,
      },
    },
  },
  oauth2: {},
  payment: {
    providers: {
      stripe: {
        publishableKey: null,
      },
      paypal: {
        clientId: null,
      },
      chargebee: {
        site: null,
      },
      coinbase: {
        enabled: false,
      },
    },
    products: [
      {
        id: 'basic',
        name: 'Basic',
        type: 'subscription',
        limits: {
          requests: 100,
        },
      },
      {
        id: 'premium',
        name: 'Premium',
        type: 'subscription',
        limits: {
          requests: 1000,
        },
        trial: {
          days: 14,
        },
        prices: {
          monthly: 4.99,
          annually: 49.99,
        },
        stripe: {
          productId: null,
        },
        paypal: {
          productId: null,
        },
        chargebee: {
          itemId: null,
          legacyPlanIds: [],
        },
      },
      {
        id: 'ultimate',
        name: 'Ultimate',
        type: 'subscription',
        limits: {
          requests: 10000,
        },
        prices: {
          monthly: 19.99,
          annually: 199.99,
        },
        stripe: {
          productId: null,
        },
        paypal: {
          productId: null,
        },
        chargebee: {
          itemId: null,
          legacyPlanIds: [],
        },
      },
      {
        id: 'credits-100',
        name: '100 Credits',
        type: 'one-time',
        prices: {
          once: 9.99,
        },
        stripe: {
          productId: null,
        },
        chargebee: {
          itemId: null,
        },
      },
      // Add more products/tiers here
    ],
  },
  cloud: {
    provider: 'firebase',
    config: {
      apiKey: '123-456',
      authDomain: 'YOUR-BRAND-DOMAIN.com', // brand host — the web build self-hosts /__/auth/*
      projectId: 'PROJECT-ID',
      storageBucket: 'PROJECT-ID.appspot.com',
      messagingSenderId: '123',
      appId: '1:123:web:456',
      measurementId: 'G-0123456789',
    },
  },

  // ─── Backend target ────────────────────────────────────────────────────────
  // Key presence = this project supports the backend target. Any shared key may
  // also appear here as a backend-only override (e.g. a per-surface
  // monitoring.providers.sentry.dsn).
  targets: {
    backend: {
      // 'self' = this @omega.js/backend is the parent (newsletter-sources provider);
      // a URL = external parent (e.g. 'https://api.itwcreativeworks.com') —
      // used by the newsletter generator to pull sources; '' = no parent
      parent: '',
      // The brand repo the content routes (admin/post CMS, content/post)
      // commit to. `repo` is optional — "owner/name" slug or bare name;
      // name defaults to brand.id, owner to repo.providers.github.org (shared derivation:
      // @omega.js/config brandRepoName/brandRepoOwner). Deliberately empty
      // by default so the routes' "not configured" guard fires instead of
      // aiming a real GH_TOKEN at a placeholder repo.
      github: {
        user: '',
        repo: '',
      },
      auth: {
        signup: {
          // Signups allowed per client IP per day. The beforeUserCreated guard
          // blocks the rest. Raise it when your audience shares egress (NAT/CGNAT,
          // VPNs, offices, campuses), where one IP fronts many real people.
          maxPerIpPerDay: 2,
        },
      },
      marketing: {
        campaigns: {
          enabled: true,
          providers: {
            sendgrid: {
              listId: '',  // SendGrid Marketing list UUID. Populated by OMEGA's campaigns/ensure/list.js. Skips runtime list-discovery API call.
            },
          },
        },
        newsletter: {
          enabled: false,
          providers: {
            beehiiv: {
              publicationId: '',  // Beehiiv publication ID (e.g., 'pub_xxxxx'). Populated by OMEGA's newsletter/ensure/publication.js. Required for marketing sync to Beehiiv.
            },
          },
          // Content is PIPELINE config, not Beehiiv config, so it stays role-level.
          // Single object or array (matches blog config shape). Generator uses the first entry.
          content: [
            {
              sources: ['$parent'],    // '$parent' | '$feed:https://...' | '$brand'
              sourceCount: 6,          // how many sources are picked (randomly) per issue
              categories: [],          // e.g., ['social-media', 'marketing'] — topic constraints + AI categorization
              links: [],               // links to inject into generated content
              instructions: '',        // free-form text passed to the AI
              tone: 'professional',    // 'professional' | 'casual' | 'actionable' | 'witty' | etc.
              keywords: [],            // SEO keywords to weave in
              template: 'clean',       // 'clean' | 'editorial' | 'field-report' — layout template
              article: {
                enabled: false,        // expand lead section into a full blog post via Ghostii
                author: null,
              },
              theme: {
                primaryColor: '#5B5BFF',
                secondaryColor: '#1E1E2A',
                accentColor: '#F6F7FB',
                font: 'Inter, system-ui, sans-serif',
              },
              sponsorships: [],
            },
          ],
        },
        // Monthly contact prune (deletes cold contacts from your mail providers).
        // OPT-IN: nothing runs unless enabled is true — see @omega.js/backend's
        // docs/marketing-campaigns.md (Contact Pruning).
        prune: {
          enabled: false,
        },
      },
      // Standalone blog auto-publisher (daily cron). OPT-IN: disabled by default.
      // Set enabled: true and quantity >= 1 to auto-publish independent blog posts.
      // For newsletter-linked articles, use marketing.newsletter.content.article.enabled instead.
      //
      // The key under `providers` selects the article-generation provider
      // (only 'ghostii' for now).
      //
      // Source types:
      //   '$brand'                          — generic brand-topic generation
      //   '$feed:https://example.com/feed'  — RSS/Atom/JSON feed: pick one unprocessed article per run
      //   '$parent'                         — fetch sources from parent server's source pool (without claiming)
      //   'https://example.com/page'        — fetch URL content as prompt seed
      //   'Write about topic X'             — text: use directly as prompt seed
      //
      // All feed/parent sources are tracked in Firestore (`content-sources`) so the same
      // article is never reprocessed. When a feed is unreachable or exhausted, falls back to $brand.
      blog: {
        enabled: false,
        providers: {
          ghostii: {},
        },
        content: [
          {
            sources: [             // '$brand' | '$feed:https://...' | '$parent'
              '$brand',
              // '$feed:https://techcrunch.com/feed/',
              // '$parent',
            ],
            categories: [],        // topic constraints + output tags
            links: [],             // links to inject into generated content
            instructions: '',      // free-form text passed to the AI
            tone: 'professional',  // 'professional' | 'casual' | 'actionable' | 'witty' | etc.
            keywords: [],          // SEO keywords to weave in
            quantity: 0,           // number of articles to generate per run
            chance: 1.0,
            author: null,
            postPath: 'ghostii',  // defaults to provider name; sub-folder under _posts/{year}/
            // Per-entry Ghostii API overrides (all optional, fall back to framework defaults)
            overrides: {
              // keywords: ['AI', 'technology'],
              // length: 'long',              // short | medium | long | comprehensive
              // research: true,              // web search for real external links
              // insertImages: true,          // section images from Unsplash
              // headerImageUrl: 'unsplash',  // disabled | unsplash | generate
              // maxLinks: 6,
              // sectionQuantity: 5,
              // feedUrl: '',                 // brand blog feed for title dedup
            },
            // brand: 'other-app-id',                // Optional: target a different brand
            // brandUrl: 'https://api.otherapp.com',  // Required if brand is set
          },
        ],
      },
      reviews: {
        enabled: true,
        sites: [
          'trustpilot.com',
        ],
      },
      dataRequest: {
        // Additional queries to include in GDPR data exports
        // @omega.js/backend always exports: users, auth record, data-requests, payments-intents, payments-orders
        // Single doc: { path: 'collection/{uid}', redact: ['field.to.redact'] }
        // Collection query: { collection: 'my-data', where: [['ownerField', '==', '{uid}']] }
        queries: [],
      },
    },
  },
}
