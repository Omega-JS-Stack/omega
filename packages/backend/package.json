{
  "name": "@omega.js/backend",
  "version": "0.1.0",
  "description": "OMEGA backend framework — build, test, and deploy Firebase Cloud Functions backends",
  "private": false,
  "main": "dist/manager/index.js",
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "templates/",
    "test/",
    "cli.js"
  ],
  "bin": {
    "omega": "./bin/omega",
    "omg": "./bin/omg",
    "mgr": "./bin/omega",
    "omega-backend": "./bin/omega-backend"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "test": "node src/test/parse-audit.js && node bin/omega-backend test",
    "prepare": "node -e \"require('@omega.js/devkit/prepare-guard')() && require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "engines": {
    "node": ">=22"
  },
  "omega": {
    "functionsRuntime": "22",
    "testLanes": [
      "stripe-live"
    ]
  },
  "projectScripts": {
    "start": "omega serve",
    "deploy": "omega deploy",
    "emulator": "omega emulator",
    "test": "node --require ./test/_helpers/connect-trap.js --test 'test/_unit/**/*.test.js'",
    "test:static": "npm test",
    "test:emulator": "omega test"
  },
  "projectScriptsCustomOwned": [
    "start",
    "deploy",
    "emulator",
    "test:emulator"
  ],
  "keywords": [
    "omega",
    "firebase",
    "firebase-functions",
    "cloud-functions",
    "firestore",
    "backend",
    "serverless",
    "api",
    "express",
    "cli"
  ],
  "author": "ITW Creative Works",
  "license": "Elastic-2.0",
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "before": "node scripts/update-disposable-domains.js",
      "after": [
        "node -e \"require('@omega.js/devkit/vendor')()\"",
        "node -e \"require('@omega.js/devkit/prepare-guard').rewire()\""
      ],
      "afterBlocking": true
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.153",
    "@anthropic-ai/sdk": "^0.99.0",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/pubsub": "^5.3.1",
    "@google-cloud/storage": "^7.21.0",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@omega.js/client": "0.1.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.54.0",
    "body-parser": "^2.3.0",
    "busboy": "^1.6.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.9.3",
    "fs-jetpack": "^5.1.0",
    "glob": "^13.0.6",
    "hcaptcha": "^0.2.0",
    "itwcw-package-analytics": "^1.0.8",
    "json5": "^2.2.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lowdb": "^7.0.1",
    "markdown-it": "^14.2.0",
    "mime-types": "^3.0.2",
    "minimatch": "^10.2.5",
    "mjml": "^5.3.0",
    "moment": "^2.30.1",
    "nanoid": "^5.1.11",
    "node-powertools": "^3.0.0",
    "pushid": "^1.0.0",
    "sanitize-html": "^2.17.5",
    "sharp": "^0.35.2",
    "stripe": "^22.2.0",
    "uid-generator": "^2.0.0",
    "uuid": "^14.0.1",
    "wonderful-fetch": "^2.0.5",
    "wonderful-log": "^1.0.7",
    "wonderful-version": "^1.3.2",
    "yaml": "^2.9.0",
    "yargs": "^18.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@omega.js/account": "*",
    "@omega.js/analytics": "*",
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "@omega.js/monitoring": "*",
    "prepare-package": "^2.2.0"
  },
  "peerDependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  }
}
