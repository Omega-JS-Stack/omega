{
  "name": "@omega.js/backend",
  "version": "0.53.0",
  "description": "OMEGA backend framework — build, test, and deploy Firebase Cloud Functions backends",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/omega/index.js",
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "templates/",
    "test/",
    "cli.js",
    "ensure-target.js",
    "migrate.js"
  ],
  "bin": {
    "omega": "bin/omega",
    "omg": "bin/omg",
    "mgr": "bin/omega"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "test": "node src/test/parse-audit.js && node cli.js test",
    "prepare": "node -e \"require('../devkit/tools/prepare-guard').run()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "engines": {
    "node": ">=22"
  },
  "omega": {
    "functionsRuntime": "22",
    "testLanes": [
      "stripe-live"
    ],
    "vendorAssets": [
      {
        "package": "@omega.js/devkit",
        "from": "src/test/esm-only-fixture.js",
        "to": "vendor/devkit/test/esm-only-fixture.js"
      },
      {
        "package": "@omega.js/devkit",
        "from": "src/test/dashed-files.js",
        "to": "vendor/devkit/test/dashed-files.js"
      },
      {
        "package": "@omega.js/devkit",
        "from": "src/test/fixtures/esm-only-package",
        "to": "vendor/devkit/test/fixtures/esm-only-package"
      }
    ]
  },
  "projectScripts": {
    "start": "omega serve",
    "emulator": "omega emulator",
    "test:static": "node --require ./test/_helpers/connect-trap.js --test 'test/_unit/**/*.test.js'"
  },
  "keywords": [
    "omega",
    "firebase",
    "firebase-functions",
    "cloud-functions",
    "firestore",
    "backend",
    "serverless",
    "api",
    "express",
    "cli"
  ],
  "author": "ITW Creative Works",
  "license": "Elastic-2.0",
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "before": "node scripts/update-disposable-domains.js",
      "after": [
        "node -e \"require('@omega.js/devkit/prepare-guard').rewire()\"",
        "node -e \"require('@omega.js/devkit/vendor')()\""
      ],
      "afterBlocking": true
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.153",
    "@anthropic-ai/sdk": "^0.99.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@google-cloud/firestore": "^7.11.6",
    "@google-cloud/pubsub": "^5.3.1",
    "@google-cloud/storage": "^7.22.0",
    "@inquirer/prompts": "^8.7.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/rest": "^22.0.1",
    "@omega.js/client": "0.53.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sendgrid/mail": "^8.1.6",
    "@sentry/node": "^10.54.0",
    "body-parser": "^2.3.0",
    "busboy": "^1.6.0",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.1",
    "fs-jetpack": "^5.1.0",
    "glob": "^13.0.6",
    "hcaptcha": "^0.2.0",
    "itwcw-package-analytics": "^1.0.8",
    "json5": "^2.2.3",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lowdb": "^7.0.1",
    "markdown-it": "^14.3.2",
    "mime-types": "^3.0.2",
    "minimatch": "^10.2.6",
    "mjml": "^5.4.1",
    "moment": "^2.31.0",
    "nanoid": "^5.1.16",
    "node-powertools": "^3.0.0",
    "pushid": "^1.0.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.2",
    "stripe": "^22.6.2",
    "uid-generator": "^2.0.0",
    "uuid": "^14.0.2",
    "wonderful-fetch": "^2.0.6",
    "wonderful-log": "^1.0.7",
    "wonderful-version": "^1.3.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@omega.js/account": "*",
    "@omega.js/analytics": "*",
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "@omega.js/monitoring": "*",
    "prepare-package": "^2.2.1"
  },
  "peerDependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5"
  }
}
