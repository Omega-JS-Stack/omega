# ========== Default Values ==========
# Commented keys are PLACEHOLDERS: values resolve through the .env cascade
# (shell > this file > brand root .env > company .env) — uncomment here only
# to override for THIS target. An empty value never claims a key (friction #20).

# GitHub
# GH_TOKEN=

# OMEGA Backend
# OMEGA_ADMIN_KEY=
# OMEGA_WEBHOOK_KEY=
# OMEGA_NAMESPACE=
# OMEGA_OPENAI_API_KEY=
# OMEGA_ANTHROPIC_API_KEY=

# AI
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=

# Payment Providers
# PAYPAL_CLIENT_SECRET=
