# Staged output (generated by omega build — src/ is the source)
dist/

# The runner symlinks @omega.js/backend, firebase-admin, and firebase-functions in here
# before booting the fixture emulator (see src/cli/commands/test.js). Never committed.
node_modules/
*.log
.temp/

# Runtime-generated throwaway RSA service account (emulator-only). Never committed.
service-account.json

# Boot-seeded BRAND rules source (from templates/firestore.rules) — the stage
# compiles it with the framework half into dist/firestore.rules, which
# firebase.json points at. See ensureFixtureRules in src/cli/commands/test.js.
# Never committed.
firestore.rules

# Per-run port-bumped emulator config (N7 auto-allocation)
firebase.resolved.json
