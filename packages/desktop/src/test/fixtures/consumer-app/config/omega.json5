{
  // Minimal @omega.js/desktop consumer config used ONLY by @omega.js/desktop's own boot-layer self-test. The fixture
  // is webpack-built (dist/main.bundle.js) and booted by src/test/runners/boot.js when
  // EM_TEST_BOOT_PROJECT points here — auto-set when @omega.js/desktop tests itself (src/commands/test.js).
  // Not a real app; never published.
  brand: {
    id: 'em-fixture',
    name: 'Desktop Fixture Consumer',
    images: {
      // Empty → build-config falls back to @omega.js/desktop's bundled default icon (no icon file shipped).
      icon: '',
    },
  },
  sentry: {
    dsn: '',
  },
  analytics: {
    providers: {
      google: { id: '' },
    },
  },
  // Empty → client-bridge skips Firebase init (no hang on a fake projectId).
  firebaseConfig: {},
  targets: {
    desktop: {
      startup: {
        mode: 'normal',
      },
      // Skip release/repo discovery during the fixture's production build (no GitHub repo behind it).
      releases: {
        enabled: false,
      },
    },
  },
}
