{
  // Minimal @omega.js/desktop consumer config used ONLY by @omega.js/desktop's own boot-layer self-test. The fixture
  // is esbuild-built (dist/main.bundle.js) and booted by src/test/runners/boot.js when
  // OMEGA_TEST_BOOT_PROJECT points here — auto-set when @omega.js/desktop tests itself (src/commands/test.js).
  // Not a real app; never published.
  brand: {
    id: 'desktop-fixture',
    name: 'Desktop Fixture Consumer',
    // The .deb target needs a homepage and a maintainer (#872): build-config
    // refuses the config without them, so the fixture spells both.
    url: 'https://desktop-fixture.test',
    contact: {
      email: 'support@desktop-fixture.test',
    },
    images: {
      // Empty → build-config falls back to @omega.js/desktop's bundled default icon (no icon file shipped).
      icon: '',
    },
  },
  monitoring: {
    providers: {
      sentry: {
        dsn: '',
      },
    },
  },
  analytics: {
    providers: {
      google: { id: '' },
    },
  },
  // Empty config → client-bridge skips Firebase init (no hang on a fake projectId).
  cloud: { provider: 'firebase', config: {} },
  targets: {
    desktop: {
      startup: {
        mode: 'normal',
      },
      // Skip release/repo discovery during the fixture's production build (no GitHub repo behind it).
      releases: {
        enabled: false,
      },
    },
  },
}
