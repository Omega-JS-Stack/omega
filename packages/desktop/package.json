{
  "name": "@omega.js/desktop",
  "version": "0.1.0",
  "description": "OMEGA desktop framework — build, test, and package Electron apps for macOS, Windows, and Linux",
  "private": false,
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/vendor/config/index.js",
    "./gulp": "./dist/gulp/main.js",
    "./main": "./dist/main.js",
    "./renderer": "./dist/renderer.js",
    "./preload": "./dist/preload.js",
    "./build": "./dist/build.js",
    "./test": "./dist/test/index.js",
    "./hooks/notarize": "./dist/hooks/notarize.js",
    "./lib/app-state": "./dist/lib/app-state.js",
    "./lib/auto-updater": "./dist/lib/auto-updater.js",
    "./lib/context-menu": "./dist/lib/context-menu.js",
    "./lib/deep-link": "./dist/lib/deep-link.js",
    "./lib/ipc": "./dist/lib/ipc.js",
    "./lib/logger": "./dist/lib/logger.js",
    "./lib/logger-lite": "./dist/lib/logger-lite.js",
    "./lib/menu": "./dist/lib/menu.js",
    "./lib/protocol": "./dist/lib/protocol.js",
    "./lib/restart-manager": "./dist/lib/restart-manager/index.js",
    "./lib/restart-manager/protocol": "./dist/lib/restart-manager/protocol.js",
    "./lib/startup": "./dist/lib/startup.js",
    "./lib/storage": "./dist/lib/storage.js",
    "./lib/templating": "./dist/lib/templating.js",
    "./lib/tray": "./dist/lib/tray.js",
    "./lib/client-bridge": "./dist/lib/client-bridge.js",
    "./lib/window-manager": "./dist/lib/window-manager.js",
    "./cli": "./dist/cli-run.js",
    "./scripts/sync-nvmrc": "./scripts/sync-nvmrc.js"
  },
  "bin": {
    "omega": "./bin/omega",
    "omg": "./bin/omg",
    "mgr": "./bin/omega",
    "omega-desktop": "./bin/omega-desktop"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "scripts/"
  ],
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "type": "copy",
    "replace": {},
    "hooks": {
      "after": [
        "node -e \"require('@omega.js/devkit/vendor')()\"",
        "node -e \"require('@omega.js/devkit/prepare-guard').rewire()\""
      ],
      "afterBlocking": true
    }
  },
  "omega": {
    "nodeRuntime": "24",
    "vendorAssets": [
      {
        "package": "@omega.js/web",
        "from": "core/css/tokens/_index.scss",
        "to": "assets/css/tokens/_index.scss"
      },
      {
        "package": "@omega.js/web",
        "from": "core/css/shell",
        "to": "assets/css/shell"
      },
      {
        "package": "@omega.js/web",
        "from": "core/css/core/_custom-font-awesome.scss",
        "to": "assets/css/core/_fontawesome.scss"
      },
      {
        "package": "@omega.js/web",
        "from": "core/js/core/app-shell.js",
        "to": "assets/js/core/app-shell.js"
      },
      {
        "package": "@omega.js/web",
        "from": "themes",
        "to": "assets/themes"
      }
    ]
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "prepare": "node -e \"require('@omega.js/devkit/prepare-guard')() && require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\"",
    "test": "node ./bin/omega-desktop test"
  },
  "projectScripts": {
    "start": "omega clean && npm run gulp --",
    "gulp": "gulp",
    "build": "omega build",
    "package": "omega package",
    "package:quick": "omega package --quick",
    "publish": "omega publish",
    "release": "omega release",
    "release:local": "omega publish --local",
    "postinstall": "node -e \"try { require('@omega.js/desktop/scripts/sync-nvmrc') } catch (e) {}\"",
    "test": "omega test",
    "electron": "electron ."
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "omega",
    "electron",
    "desktop-app",
    "cross-platform",
    "electron-builder",
    "electron-updater",
    "auto-update",
    "gulp",
    "sass",
    "esbuild"
  ],
  "author": "ITW Creative Works",
  "license": "Elastic-2.0",
  "peerDependencies": {
    "electron": ">=42",
    "electron-builder": ">=26",
    "gulp": "^5.0.1"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@omega.js/analytics": "*",
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "@omega.js/monitoring": "*",
    "@omega.js/web": "*",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "firebase-admin": "^13.9.0",
    "prepare-package": "^2.2.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@inquirer/prompts": "^8.5.2",
    "@octokit/rest": "^22.0.1",
    "@omega.js/client": "0.1.0",
    "@popperjs/core": "^2.11.8",
    "@sentry/electron": "^7.13.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "electron-log": "^5.4.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "esbuild": "^0.28.1",
    "extract-zip": "^2.0.1",
    "fs-jetpack": "^5.1.0",
    "glob": "^13.0.6",
    "gulp-clean-css": "^4.3.0",
    "gulp-rename": "^2.1.0",
    "gulp-responsive-modern": "^1.0.0",
    "gulp-sass": "^6.0.1",
    "js-yaml": "^4.1.1",
    "json5": "^2.2.3",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "node-powertools": "^3.0.0",
    "plist": "^4.0.0",
    "sass": "^1.99.0",
    "uuid": "^14.0.0",
    "wonderful-fetch": "^2.0.5",
    "wonderful-version": "^1.3.2",
    "ws": "^8.20.0",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "automately": "^1.0.5"
  }
}
