{
  "name": "@omega.js/manager",
  "version": "0.1.0",
  "description": "The OMEGA orchestration engine — walks every service in dependency order and reconciles each to the brand's omega.json5, idempotently, against a brand monorepo. omega-manager's brains, ported service by service. Private until first publish.",
  "private": true,
  "main": "./src/index.js",
  "bin": {
    "omega-manager": "./bin/omega-manager"
  },
  "exports": {
    ".": "./src/index.js",
    "./cli": "./src/cli-run.js",
    "./service-runner": "./src/lib/service-runner.js",
    "./run-summary": "./src/lib/run-summary.js",
    "./brand": "./src/lib/brand.js",
    "./state": "./src/lib/state.js",
    "./manage": "./src/manage.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "ag-psd": "^31.0.2",
    "@omega.js/backend": "*",
    "canvas": "^3.2.3",
    "chalk": "^5.6.2",
    "fs-jetpack": "^5.1.0",
    "json5": "^2.2.3",
    "opentype.js": "^2.0.0",
    "png2icons": "^2.0.1",
    "psl": "^1.15.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.0",
    "ws": "^8.21.0",
    "yargs": "^18.0.0"
  },
  "engines": {
