{
  "name": "@omega.js/manager",
  "version": "0.1.0",
  "description": "The OMEGA orchestration engine — walks every service in dependency order and reconciles each to the brand's omega.json5, idempotently, against a brand monorepo. omega-manager's brains, ported service by service. Private until first publish.",
  "private": true,
  "main": "./dist/index.js",
  "bin": {
    "omega-manager": "./bin/omega-manager"
  },
  "files": [
    ".claude-plugin/",
    "bin/",
    "claude-plugin/",
    "dist/",
    "docs/"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./cli": "./dist/cli-run.js",
    "./service-runner": "./dist/lib/service-runner.js",
    "./run-summary": "./dist/lib/run-summary.js",
    "./brand": "./dist/lib/brand.js",
    "./state": "./dist/lib/state.js",
    "./manage": "./dist/manage.js"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "prepare": "node -e \"require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\"",
    "test": "node --test test/*.test.js"
  },
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "after": "node -e \"require('@omega.js/devkit/vendor')()\"",
      "afterBlocking": true
    }
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@omega.js/backend": "^0.1.0",
    "ag-psd": "^31.0.2",
    "canvas": "^3.2.3",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "fs-jetpack": "^5.1.0",
    "json5": "^2.2.3",
    "node-powertools": "^3.0.0",
    "opentype.js": "^2.0.0",
    "png2icons": "^2.0.1",
    "psl": "^1.15.0",
    "sharp": "^0.35.3",
    "stripe": "^22.3.0",
    "ws": "^8.21.0",
    "yargs": "^18.0.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": ">=0.2"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@omega.js/account": "*",
    "@omega.js/config": "*",
    "@omega.js/devkit": "*",
    "prepare-package": "^2.2.0"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ITW Creative Works",
  "license": "MIT"
}
