{
  "name": "@omega.js/devkit",
  "version": "0.1.0",
  "description": "Shared build-time internals for the OMEGA frameworks — private workspace package, vendored into each framework's dist at prepare time",
  "private": true,
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./logger": "./src/logger.js",
    "./local": "./src/local.js",
    "./local-https": "./src/local-https.js",
    "./safe-install": "./src/safe-install.js",
    "./npm-registry": "./src/npm-registry.js",
    "./attach-log-file": "./src/attach-log-file.js",
    "./cli-router": "./src/cli-router.js",
    "./prompt": "./src/prompt.js",
    "./flows": "./src/flows.js",
    "./icons": "./src/icons.js",
    "./defaults-engine": "./src/defaults-engine.js",
    "./merge-line-files": "./src/merge-line-files.js",
    "./translate": "./src/translate/index.js",
    "./deploy": "./src/deploy.js",
    "./update": "./src/update.js",
    "./deploy-record": "./src/deploy-record.js",
    "./clean-dirs": "./src/clean-dirs.js",
    "./parse-audit": "./src/parse-audit.js",
    "./test/runner-core": "./src/test/runner-core.js",
    "./test/scope": "./src/test/scope.js",
    "./test/assert": "./src/test/assert.js",
    "./test/extended-mode-warning": "./src/test/extended-mode-warning.js",
    "./test/prompt-streams": "./src/test/prompt-streams.js",
    "./test/e2e-harness": "./src/test/e2e-harness.js",
    "./test/journey-harness": "./src/test/journey-harness.js",
    "./vendor": "./tools/vendor.js",
    "./omega-bin": "./src/omega-bin.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "ITW Creative Works",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@omega.js/client": "*",
    "@omega.js/config": "*",
    "chalk": "^5.6.2",
    "fs-jetpack": "^5.1.0",
    "json5": "^2.2.3",
    "minimatch": "^10.2.5",
    "node-powertools": "^3.0.0"
  }
}
