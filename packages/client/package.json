{
  "name": "@omega.js/client",
  "version": "0.50.0",
  "description": "OMEGA client runtime — the shared frontend singleton (Firebase auth, account, analytics, notifications, bindings) embedded by the OMEGA web, desktop, and extension frameworks",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "files": [
    "dist/",
    "docs/"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./modules/*": "./dist/modules/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "test": "npm run prepare && node --require @omega.js/devkit/test/stdout-guard --require ./test/setup.js --test-timeout=10000 --test test/*.test.js",
    "prepare_": "node -e 'require(`prepare-package`)()'",
    "prepare": "node -e \"require('../devkit/tools/prepare-guard')() && require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "omega",
    "library"
  ],
  "author": "ITW Creative Works",
  "license": "Elastic-2.0",
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "after": [
        "node -e \"require('@omega.js/devkit/vendor')()\"",
        "node -e \"require('@omega.js/devkit/prepare-guard').rewire()\""
      ],
      "afterBlocking": true
    }
  },
  "notes": {
    "@sentry/browser": "Resolved by using OVERRIDES in @omega.js/client (lighthouse is the issue"
  },
  "dependencies": {
    "@sentry/browser": "^10.57.0",
    "chatsy": "^2.0.14",
    "firebase": "^12.14.0",
    "lodash": "^4.18.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@omega.js/account": "*",
    "@omega.js/analytics": "*",
    "@omega.js/devkit": "*",
    "@omega.js/monitoring": "*",
    "prepare-package": "^2.2.0"
  }
}
