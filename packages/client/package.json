{
  "name": "@omega.js/client",
  "version": "5.0.0",
  "description": "OMEGA client runtime — the shared frontend singleton (Firebase auth, account, analytics, notifications, bindings) embedded by the OMEGA web, desktop, and extension frameworks",
  "main": "dist/index.js",
  "files": [
    "dist/",
    "src/",
    "docs/",
    "CLAUDE.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./modules/*": "./dist/modules/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "npm run prepare:watch",
    "test": "npm run prepare && mocha --require ./test/setup.js --require ./test/helpers.js 'test/tests/**/*.test.js' --timeout=10000 --exit",
    "prepare_": "node -e 'require(`prepare-package`)()'",
    "prepare": "node -e \"require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "engines": {
    "node": ">=12"
  },
  "keywords": [
    "omega",
    "library"
  ],
  "author": "ITW Creative Works",
  "license": "MIT",
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {
      "after": "node -e \"require('@omega.js/devkit/vendor')()\""
    }
  },
  "notes": {
    "@sentry/browser": "Resolved by using OVERRIDES in @omega.js/client (lighthouse is the issue"
  },
  "dependencies": {
    "@sentry/browser": "^10.57.0",
    "chatsy": "^2.0.14",
    "firebase": "^12.14.0",
    "itwcw-package-analytics": "^1.0.8",
    "lodash": "^4.18.1"
  },
  "devDependencies": {
    "@omega.js/account": "*",
    "@omega.js/devkit": "*",
    "mocha": "^11.7.6",
    "prepare-package": "^2.1.0"
  }
}
